<aside id="sidebar" class="bg-slate-900/95 backdrop-blur-xl w-64 flex-shrink-0 border-r border-slate-800 flex flex-col transition-transform duration-300 md:relative md:translate-x-0 absolute inset-y-0 left-0 z-40 transform -translate-x-full">
    
    {# Logo Area — same height as topbar, no bottom border to avoid double-line with navbar #}
    <div class="h-20 flex items-center justify-between px-6">
        <a href="{{ path('app_home') }}" class="flex items-center gap-3 cursor-pointer group">
            <img src="{{ asset('images/logo.png') }}" alt="EduPulse Logo" class="h-10 w-auto group-hover:scale-105 transition-transform">
            <span class="text-xl font-bold tracking-tight text-white sidebar-text">
                Edu<span class="text-indigo-400 font-light italic">Pulse</span>
            </span>
        </a>
        
        {# Desktop Collapse Button #}
        <button onclick="toggleSidebar()" class="hidden md:flex items-center justify-center w-9 h-9 rounded-xl bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 hover:bg-indigo-500/20 hover:text-indigo-300 transition-all shadow-lg shadow-indigo-500/5">
            <svg class="w-5 h-5 transition-transform duration-300 body.sidebar-collapsed:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path>
            </svg>
        </button>

        {# Bouton de fermeture sur mobile #}
        <button onclick="toggleSidebar()" class="md:hidden text-indigo-400 bg-indigo-500/10 p-2.5 rounded-xl border border-indigo-500/20 hover:bg-indigo-500/20 hover:text-indigo-300 transition-all">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>

    </div>


    {# Navigation Links #}
    <nav class="flex-1 py-6 px-4 space-y-8 overflow-y-auto custom-scrollbar">
        
        {# Section 1: Principal #}
        <div class="space-y-1.5">
            <div class="text-[10px] font-extrabold text-slate-500 uppercase tracking-widest mb-3 px-3">Principal</div>
            
            <a href="{{ path('app_dashboard') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') starts with 'app_dashboard' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                <div class="flex items-center gap-4">
                    <div class="flex-shrink-0 flex items-center justify-center transition-transform group-hover:scale-110 group-hover:-translate-y-0.5 duration-300">
                        <img src="{{ asset('icons/Minimalist_house_icon.png') }}" alt="Dashboard" class="w-5 h-5 object-contain drop-shadow-[0_0_8px_rgba(99,102,241,0.3)]">
                    </div>
                    <span class="text-[15px]">Tableau de bord</span>
                </div>
            </a>

            <a href="{{ path('app_courses') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') starts with 'app_courses' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                <div class="flex items-center gap-4">
                    <div class="flex-shrink-0 flex items-center justify-center transition-transform group-hover:scale-110 group-hover:-translate-y-0.5 duration-300">
                        <img src="{{ asset('icons/coursecatloge-.png') }}" alt="Catalogue" class="w-5 h-5 object-contain">
                    </div>
                    <span class="text-[15px]">Catalogue Cours</span>
                </div>
            </a>

            <a href="{{ path('app_chat') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium transition-all group">
                <div class="flex items-center gap-4">
                    <div class="flex-shrink-0 flex items-center justify-center transition-transform group-hover:scale-110 group-hover:-translate-y-0.5 duration-300">
                        <img src="{{ asset('icons/messagesSection.png') }}" alt="Messages" class="w-5 h-5 object-contain">
                    </div>
                    <span class="text-[15px]">Messages</span>
                </div>
                <span class="bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 text-[10px] font-bold px-2 py-0.5 rounded-full">Chat</span>
            </a>

            <a href="{{ path('app_profile') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') == 'app_profile' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                <div class="flex items-center gap-4">
                    <div class="flex-shrink-0 flex items-center justify-center transition-transform group-hover:scale-110 group-hover:-translate-y-0.5 duration-300">
                        <img src="{{ asset('icons/authntification.png') }}" alt="Profil" class="w-5 h-5 object-contain">
                    </div>
                    <span class="text-[15px]">Mon Profil</span>
                </div>
            </a>
        </div>

        {% if is_granted('ROLE_ADMIN') %}
        {# Section 2: Administration #}
        <div class="space-y-1.5">
            <div class="text-[10px] font-extrabold text-slate-500 uppercase tracking-widest mb-3 px-3">Administration</div>
            
            <a href="{{ path('app_admin_user_index') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') starts with 'app_admin_user' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                <div class="flex items-center gap-4">
                    <div class="flex-shrink-0 flex items-center justify-center transition-transform group-hover:scale-110 group-hover:-translate-y-0.5 duration-300">
                        <img src="{{ asset('icons/Group_of_users_icon.png') }}" alt="Utilisateurs" class="w-5 h-5 object-contain">
                    </div>
                    <span class="text-[15px]">Utilisateurs</span>
                </div>
            </a>

            <a href="{{ path('app_admin_teacher_index') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') starts with 'app_admin_teacher' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                <div class="flex items-center gap-4">
                    <div class="flex-shrink-0 flex items-center justify-center transition-transform group-hover:scale-110 group-hover:-translate-y-0.5 duration-300">
                        <img src="{{ asset('icons/teatcherr.png') }}" alt="Formateurs" class="w-5 h-5 object-contain">
                    </div>
                    <span class="text-[15px]">Formateurs</span>
                </div>
            </a>

            <a href="{{ path('app_admin_course_index') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') starts with 'app_admin_course' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                <div class="flex items-center gap-4">
                    <div class="flex-shrink-0 flex items-center justify-center transition-transform group-hover:scale-110 group-hover:-translate-y-0.5 duration-300">
                        <img src="{{ asset('icons/Library_and_Books_icon.png') }}" alt="Cours" class="w-5 h-5 object-contain">
                    </div>
                    <span class="text-[15px]">Cours</span>
                </div>
            </a>

        </div>
        {% endif %}
        
    </nav>

    {# Logout Button Area #}
    <div class="p-4 border-t border-white/5 bg-slate-900/50">
        <a href="{{ path('app_logout') }}" 
           class="flex items-center gap-4 px-4 py-3 rounded-xl text-red-400 hover:bg-red-500/10 hover:text-red-300 transition-all group overflow-hidden relative">
            <div class="absolute inset-0 bg-gradient-to-r from-red-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            
            <div class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-lg bg-red-500/10 group-hover:scale-110 transition-transform duration-300">
                <img src="{{ asset('icons/Logout_icon_exit.png') }}" alt="Déconnexion" class="w-5 h-5 object-contain">
            </div>
            
            <div class="flex flex-col">
                <span class="text-[14px] font-bold tracking-tight">Déconnexion</span>
                <span class="text-[10px] text-slate-500 group-hover:text-red-400/60 transition-colors uppercase font-black tracking-widest">Quitter la session</span>
            </div>

            <div class="ml-auto opacity-0 group-hover:opacity-100 transform translate-x-2 group-hover:translate-x-0 transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </div>
        </a>
    </div>
</aside>

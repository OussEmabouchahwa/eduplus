<div class="w-full max-w-xl">
    <form action="#" method="GET" class="relative group w-full">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none z-10">
            <img src="{{ asset('icons/Search.png') }}" 
                 alt="Search" 
                 class="w-10 h-10 object-contain opacity-70 group-focus-within:opacity-100 transition-opacity">
        </div>
        
        <input type="text" 
               placeholder="        Rechercher..." 
               class="block w-full bg-slate-900/40 border border-white/5 rounded-2xl py-3 pl-12 pr-6 text-[14px] text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500/30 focus:bg-slate-900/60 transition-all shadow-inner backdrop-blur-md relative z-0">
    </form>
</div>

<div class="flex-1"></div>

{# User Profile in Topbar #}
<div class="flex items-center gap-8 ml-auto">
    {% if app.user %}
        {# Notifications #}
    <button class="p-2 text-slate-400 hover:text-white rounded-2xl hover:bg-white/5 transition-all group">
        <div class="relative w-10 h-10 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="absolute top-0 right-0 w-3 h-3 bg-red-500 rounded-full border-2 border-slate-900 z-10 animate-pulse"></span>
            <img src="{{ asset('icons/Notification.png') }}" alt="Notifications" class="w-8 h-8 object-contain">
        </div>
    </button>
        
    {# Profile Menu #}
    <div class="flex items-center gap-4 pl-8 border-l border-white/10">
        <div class="text-right hidden md:block">
            <p class="text-base font-bold text-white leading-tight">{{ app.user.firstName }} {{ app.user.lastName }}</p>
            <p class="text-sm text-indigo-400 font-medium">{% if is_granted('ROLE_ADMIN') %}Administrateur{% elseif is_granted('ROLE_TEACHER') %}Formateur{% else %}Étudiant{% endif %}</p>
        </div>
        
        <div class="relative group">
            <div class="flex items-center gap-4 cursor-pointer py-2">
                <div class="w-14 h-14 rounded-full border-2 border-indigo-500/30 overflow-hidden shadow-2xl shadow-indigo-500/10 transition-transform group-hover:scale-105">
                    {% if app.user.profilePhoto %}
                        <img src="{{ asset('uploads/profiles/' ~ app.user.profilePhoto) }}" alt="Profile Photo" class="w-full h-full object-cover">
                    {% else %}
                        <div class="w-full h-full bg-slate-800 flex items-center justify-center text-slate-300 font-bold uppercase text-lg">
                            {{ app.user.firstName|first }}{{ app.user.lastName|first }}
                        </div>
                    {% endif %}
                </div>
                <svg class="w-5 h-5 text-slate-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
            </div>
            
            {# Dropdown Menu #}
            <div class="absolute right-0 top-full w-72 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 translate-y-4 group-hover:translate-y-2 z-[999]">
                <div class="mt-2 bg-slate-900/95 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl overflow-hidden p-2">
                    <div class="px-5 py-4 border-b border-white/5 mb-2 bg-white/5 rounded-xl">
                        <p class="text-[15px] font-bold text-white truncate">{{ app.user.firstName }} {{ app.user.lastName }}</p>
                        <p class="text-xs text-indigo-400 font-black uppercase tracking-wider mt-1">
                            {% if is_granted('ROLE_ADMIN') %}Administrateur{% elseif is_granted('ROLE_TEACHER') %}Formateur{% else %}Étudiant{% endif %}
                        </p>
                    </div>
                    <div class="p-2">
                            <a href="{{ path('app_profile') }}" class="flex items-center gap-3 px-3 py-2.5 text-sm text-slate-300 hover:text-white hover:bg-white/5 rounded-xl transition-all group/item">
                                <div class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center group-hover/item:bg-indigo-500/20 transition-colors">
                                    <img src="{{ asset('icons/Settingsicon.png') }}" alt="Settings" class="w-4 h-4 object-contain">
                                </div>
                                <span>Mon Profil</span>
                            </a>
                            <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-3 py-2.5 text-sm font-semibold text-red-400 hover:text-red-300 hover:bg-red-500/10 rounded-xl transition-all group/item">
                                <div class="w-8 h-8 rounded-lg bg-red-500/10 flex items-center justify-center group-hover/item:bg-red-500/20 transition-colors">
                                    <img src="{{ asset('icons/Logout_icon_exit.png') }}" alt="Logout" class="w-4 h-4 object-contain">
                                </div>
                                <span>Déconnexion</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="flex items-center gap-3">
            <a href="{{ path('app_login') }}" class="text-slate-400 hover:text-white font-bold text-sm transition-colors">Connexion</a>
            <a href="{{ path('app_register') }}" class="bg-indigo-500 hover:bg-indigo-400 text-white px-5 py-2.5 rounded-xl font-black text-sm transition-all shadow-lg shadow-indigo-500/20">S'inscrire</a>
        </div>
    {% endif %}
</div>

{% extends 'base_dashboard.html.twig' %}

{% block title %}EduPulse | Mon Tableau de Bord{% endblock %}
{% block page_title %}Mon Espace Étudiant{% endblock %}

{% block body %}
<div class="space-y-8 animate-fade-in relative pb-12">
    
    {# Welcome Header #}
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h1 class="text-3xl font-black text-white tracking-tight">Bienvenue, {{ app.user.firstName }} ! 👋</h1>
            <p class="text-slate-400 mt-2 font-medium">Ravi de vous revoir. Poursuivez votre apprentissage là où vous vous étiez arrêté.</p>
        </div>
        <div class="flex items-center gap-4">
            <div class="px-6 py-3 bg-indigo-500/10 border border-indigo-500/20 rounded-2xl text-indigo-400 text-sm font-black uppercase tracking-widest shadow-lg shadow-indigo-500/5">
                {{ "now"|date("d M Y") }}
            </div>
        </div>
    </div>

    {# Dashboard Stats #}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass-card p-8 flex items-center gap-6 group hover:border-indigo-500/30 transition-all duration-500">
            <div class="flex-shrink-0 w-16 h-16 bg-indigo-500/10 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-500 shadow-2xl">
                <img src="{{ asset('icons/Library_and_Books_icon.png') }}" alt="Courses" class="w-10 h-10 object-contain">
            </div>
            <div>
                <div class="text-[10px] text-slate-500 uppercase font-black tracking-[0.2em]">Mes Formations</div>
                <div class="text-3xl font-black text-white leading-none mt-2">{{ enrolledCourses|length }}</div>
            </div>
        </div>
        
        <div class="glass-card p-8 flex items-center gap-6 group hover:border-cyan-500/30 transition-all duration-500">
            <div class="flex-shrink-0 w-16 h-16 bg-cyan-500/10 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-500 shadow-2xl">
                <img src="{{ asset('icons/messagesSection.png') }}" alt="Messages" class="w-10 h-10 object-contain">
            </div>
            <div>
                <div class="text-[10px] text-slate-500 uppercase font-black tracking-[0.2em]">Salons de Discussion</div>
                <div class="text-3xl font-black text-white leading-none mt-2">{{ enrolledCourses|length }}</div>
            </div>
        </div>

        <div class="glass-card p-8 flex items-center gap-6 group hover:border-emerald-500/30 transition-all duration-500">
            <div class="flex-shrink-0 w-16 h-16 bg-emerald-500/10 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-500 shadow-2xl">
                <img src="{{ asset('icons/Certification_icon_with_diploma_.png') }}" alt="Certificates" class="w-10 h-10 object-contain">
            </div>
            <div>
                <div class="text-[10px] text-slate-500 uppercase font-black tracking-[0.2em]">Certificats Gagnés</div>
                <div class="text-3xl font-black text-white leading-none mt-2">0</div>
            </div>
        </div>
    </div>

    {# My Enrolled Courses Section #}
    <div class="space-y-6">
        <div class="flex items-center justify-between">
            <h2 class="text-xl font-black text-white uppercase tracking-widest italic">Mes Cours en cours</h2>
            <a href="{{ path('app_home') }}#courses" class="text-xs text-indigo-400 hover:text-indigo-300 font-black uppercase tracking-widest transition-colors flex items-center gap-2">
                Découvrir plus
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
        </div>

        {% if enrolledCourses is empty %}
            <div class="glass-card p-12 text-center border-dashed border-white/10">
                <div class="w-20 h-20 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-6">
                    <img src="{{ asset('icons/Library_and_Books_icon.png') }}" alt="Empty" class="w-10 h-10 opacity-20 grayscale">
                </div>
                <h3 class="text-xl font-bold text-white mb-2">Aucun cours trouvé</h3>
                <p class="text-slate-400 mb-8 max-w-sm mx-auto">Vous n'êtes inscrit à aucune formation pour le moment. Commencez votre aventure aujourd'hui !</p>
                <a href="{{ path('app_home') }}#courses" class="px-8 py-4 bg-indigo-500 hover:bg-indigo-400 text-white rounded-xl font-black uppercase tracking-widest transition-all shadow-xl shadow-indigo-500/20">Explorer le catalogue</a>
            </div>
        {% else %}
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                {% for course in enrolledCourses %}
                    <div class="glass-card group overflow-hidden flex flex-col md:flex-row transition-all duration-500 hover:border-indigo-500/30 hover:-translate-y-1">
                        {# Course Thumbnail #}
                        <div class="w-full md:w-48 h-48 flex-shrink-0 relative overflow-hidden">
                            {% set imgSrc = course.imagePath ? (course.imagePath starts with 'courses/' ? asset('images/' ~ course.imagePath) : asset('uploads/courses/' ~ course.imagePath)) : asset('images/landingpage/Learning Space.png') %}
                            <img src="{{ imgSrc }}" alt="{{ course.title }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                            <div class="absolute inset-0 bg-slate-900/40 group-hover:bg-slate-900/10 transition-colors"></div>
                        </div>

                        {# Course Info #}
                        <div class="flex-1 p-6 flex flex-col justify-between">
                            <div>
                                <h3 class="text-lg font-bold text-white mb-2 group-hover:text-indigo-400 transition-colors">{{ course.title }}</h3>
                                <p class="text-slate-400 text-xs font-medium leading-relaxed line-clamp-2 italic mb-4">
                                    {{ course.description }}
                                </p>
                            </div>

                            <div class="flex items-center justify-between gap-4 mt-auto">
                                <a href="{{ path('app_chat_room', {'courseId': course.id}) }}" class="flex-1 px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-center text-[10px] font-black uppercase tracking-widest text-slate-300 hover:bg-white/10 hover:text-white transition-all flex items-center justify-center gap-2">
                                    <img src="{{ asset('icons/messagesSection.png') }}" class="w-4 h-4 object-contain" alt="">
                                    Chat de classe
                                </a>
                                <a href="{{ path('app_course_show', {'slug': course.slug}) }}" class="flex-1 px-4 py-2.5 rounded-xl bg-indigo-500 text-center text-[10px] font-black uppercase tracking-widest text-white hover:bg-indigo-400 transition-all shadow-lg shadow-indigo-500/10">
                                    Continuer
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {# Interactive Learning Promotion #}
    <div class="glass-card p-10 bg-gradient-to-br from-indigo-600/10 to-transparent border-indigo-500/20 overflow-hidden relative">
        <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-500/10 blur-[80px] rounded-full -translate-y-1/2 translate-x-1/2"></div>
        <div class="relative z-10 flex flex-col md:flex-row items-center gap-10">
            <div class="w-24 h-24 flex-shrink-0 bg-indigo-500/20 rounded-[2.5rem] flex items-center justify-center shadow-2xl">
                <div class="w-16 h-16 bg-slate-950/50 rounded-2xl flex items-center justify-center">
                    <img src="{{ asset('icons/messagesSection.png') }}" class="w-10 h-10 object-contain" alt="">
                </div>
            </div>
            <div class="flex-1 text-center md:text-left">
                <h3 class="text-2xl font-black text-white mb-3">Besoin d'aide ? Posez vos questions !</h3>
                <p class="text-slate-400 font-medium max-w-xl">Nos salons de discussion sont ouverts 24/7. Échangez avec vos professeurs et profitez de l'intelligence collective d'EduPulse.</p>
            </div>
            <a href="{{ path('app_chat') }}" class="px-8 py-4 bg-white text-slate-950 font-black rounded-2xl hover:scale-105 transition-all shadow-2xl">
                Ouvrir le Chat
            </a>
        </div>
    </div>

</div>
{% endblock %}

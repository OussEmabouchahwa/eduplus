

{# The navbar sits at z-[9999] to always be above hero decorations and page content #}
<nav id="landing-navbar" style="position:fixed;top:0;left:0;right:0;z-index:9999;height:5rem;display:flex;align-items:center;justify-content:space-between;padding:0 3rem;border-bottom:1px solid rgba(255,255,255,0.05);background:rgba(2,6,23,0.85);backdrop-filter:blur(24px);pointer-events:auto;">

    {# Logo #}
    <a href="{{ path('app_home') }}" style="display:flex;align-items:center;gap:0.75rem;text-decoration:none;cursor:pointer;flex-shrink:0;pointer-events:auto;">
        <div style="width:2.5rem;height:2.5rem;background:rgba(255,255,255,0.05);border-radius:0.75rem;display:flex;align-items:center;justify-content:center;">
            <img src="{{ asset('images/logo.png') }}" alt="EduPulse Logo" style="width:1.75rem;height:1.75rem;object-fit:contain;">
        </div>
        <span style="font-size:1.25rem;font-weight:700;color:white;letter-spacing:-0.025em;">
            Edu<span style="color:#818cf8;font-style:italic;font-weight:300;">Pulse</span>
        </span>
    </a>

    {# Section Links - Desktop #}
    <div class="hidden md:flex" style="align-items:center;gap:0.25rem;pointer-events:auto;">
        <a href="#hero"         onclick="scrollToSection('hero');return false;"         class="nav-link" style="padding:0.5rem 1rem;font-size:0.875rem;font-weight:600;color:#94a3b8;text-decoration:none;border-radius:0.75rem;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.color='white';this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.color='#94a3b8';this.style.background='transparent'">Accueil</a>
        <a href="#features"     onclick="scrollToSection('features');return false;"     class="nav-link" style="padding:0.5rem 1rem;font-size:0.875rem;font-weight:600;color:#94a3b8;text-decoration:none;border-radius:0.75rem;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.color='white';this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.color='#94a3b8';this.style.background='transparent'">Fonctionnalités</a>
        <a href="#courses"      onclick="scrollToSection('courses');return false;"      class="nav-link" style="padding:0.5rem 1rem;font-size:0.875rem;font-weight:600;color:#94a3b8;text-decoration:none;border-radius:0.75rem;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.color='white';this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.color='#94a3b8';this.style.background='transparent'">Catalogue</a>
        <a href="#stats"        onclick="scrollToSection('stats');return false;"        class="nav-link" style="padding:0.5rem 1rem;font-size:0.875rem;font-weight:600;color:#94a3b8;text-decoration:none;border-radius:0.75rem;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.color='white';this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.color='#94a3b8';this.style.background='transparent'">Statistiques</a>
        <a href="#testimonials" onclick="scrollToSection('testimonials');return false;" class="nav-link" style="padding:0.5rem 1rem;font-size:0.875rem;font-weight:600;color:#94a3b8;text-decoration:none;border-radius:0.75rem;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.color='white';this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.color='#94a3b8';this.style.background='transparent'">Témoignages</a>
    </div>

    {# Right: Auth Buttons — always visible + Mobile burger #}
    <div style="display:flex;align-items:center;gap:0.75rem;pointer-events:auto;">

        {% if app.user %}
            <a href="{{ path('app_dashboard') }}" style="display:flex;align-items:center;gap:0.5rem;padding:0.625rem 1.25rem;background:#6366f1;color:white;font-weight:900;font-size:0.875rem;border-radius:1rem;text-decoration:none;cursor:pointer;transition:all 0.2s;box-shadow:0 4px 20px rgba(99,102,241,0.3);" onmouseover="this.style.background='#818cf8';this.style.transform='translateY(-1px)'" onmouseout="this.style.background='#6366f1';this.style.transform='translateY(0)'">
                <img src="{{ asset('icons/Minimalist_house_icon.png') }}" alt="" style="width:1rem;height:1rem;object-fit:contain;">
                <span>Tableau de bord</span>
            </a>
        {% else %}
            <a href="{{ path('app_login') }}" style="padding:0.5rem 1rem;font-size:0.875rem;font-weight:700;color:#cbd5e1;text-decoration:none;border-radius:0.75rem;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.color='white';this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.color='#cbd5e1';this.style.background='transparent'">
                Connexion
            </a>
            <a href="{{ path('app_register') }}" style="padding:0.625rem 1.25rem;background:#6366f1;color:white;font-weight:900;font-size:0.875rem;border-radius:1rem;text-decoration:none;cursor:pointer;transition:all 0.2s;box-shadow:0 4px 20px rgba(99,102,241,0.3);" onmouseover="this.style.background='#818cf8';this.style.transform='translateY(-1px)'" onmouseout="this.style.background='#6366f1';this.style.transform='translateY(0)'">
                S'inscrire
            </a>
        {% endif %}

        {# Mobile Burger #}
        <button id="landing-menu-btn" onclick="toggleMobileMenu()" style="display:none;padding:0.5rem;color:#94a3b8;background:transparent;border:none;border-radius:0.75rem;cursor:pointer;pointer-events:auto;" class="md-hidden-show-sm">
            <svg style="width:1.5rem;height:1.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>
</nav>

{# Mobile Section Links Drawer #}
<div id="landing-mobile-menu" style="display:none;position:fixed;left:0;right:0;top:5rem;z-index:9998;padding:0 1rem;">
    <div style="background:rgba(15,23,42,0.99);backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,0.1);border-radius:1.5rem;box-shadow:0 25px 50px rgba(0,0,0,0.5);padding:1rem;">
        <a href="#hero"         onclick="scrollToSection('hero');toggleMobileMenu();return false;"         style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;font-size:0.875rem;font-weight:600;color:#cbd5e1;text-decoration:none;border-radius:1rem;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='transparent'">
            <img src="{{ asset('icons/Minimalist_house_icon.png') }}" alt="" style="width:1.25rem;height:1.25rem;object-fit:contain;opacity:0.6;">Accueil
        </a>
        <a href="#features"     onclick="scrollToSection('features');toggleMobileMenu();return false;"     style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;font-size:0.875rem;font-weight:600;color:#cbd5e1;text-decoration:none;border-radius:1rem;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='transparent'">
            <img src="{{ asset('icons/Library_and_Books_icon.png') }}" alt="" style="width:1.25rem;height:1.25rem;object-fit:contain;opacity:0.6;">Fonctionnalités
        </a>
        <a href="#courses"      onclick="scrollToSection('courses');toggleMobileMenu();return false;"      style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;font-size:0.875rem;font-weight:600;color:#cbd5e1;text-decoration:none;border-radius:1rem;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='transparent'">
            <img src="{{ asset('icons/coursecatloge-.png') }}" alt="" style="width:1.25rem;height:1.25rem;object-fit:contain;opacity:0.6;">Catalogue
        </a>
        <a href="#stats"        onclick="scrollToSection('stats');toggleMobileMenu();return false;"        style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;font-size:0.875rem;font-weight:600;color:#cbd5e1;text-decoration:none;border-radius:1rem;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='transparent'">
            <img src="{{ asset('icons/Group_of_users_icon.png') }}" alt="" style="width:1.25rem;height:1.25rem;object-fit:contain;opacity:0.6;">Statistiques
        </a>
    </div>
</div>

<style>
    /* Smooth scroll with navbar offset */
    html { scroll-behavior: smooth; }
    section[id] { scroll-margin-top: 5rem; }

    /* Show burger on small screens */
    @media (max-width: 768px) {
        .md-hidden-show-sm { display: block !important; }
    }
</style>

<script>
    function scrollToSection(id) {
        const el = document.getElementById(id);
        if (el) {
            const top = el.getBoundingClientRect().top + window.scrollY - 80;
            window.scrollTo({ top: top, behavior: 'smooth' });
        }
    }

    function toggleMobileMenu() {
        const menu = document.getElementById('landing-mobile-menu');
        if (menu.style.display === 'none' || menu.style.display === '') {
            menu.style.display = 'block';
        } else {
            menu.style.display = 'none';
        }
    }
</script>

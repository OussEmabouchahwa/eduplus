{# =========================================================================
   LANDING PAGE NAVBAR - Navigation publique avec liens de section
   ========================================================================= #}
<nav id="landing-navbar" class="fixed top-0 left-0 right-0 z-50 h-20 flex items-center justify-between px-6 md:px-12 border-b border-white/5 bg-slate-950/80 backdrop-blur-2xl">

    {# Logo #}
    <a href="{{ path('app_home') }}" class="flex items-center gap-3 group flex-shrink-0">
        <div class="w-10 h-10 bg-white/5 rounded-2xl flex items-center justify-center group-hover:scale-105 transition-transform shadow-lg">
            <img src="{{ asset('images/logo.png') }}" alt="EduPulse Logo" class="w-7 h-7 object-contain">
        </div>
        <span class="text-xl font-bold tracking-tight text-white">
            Edu<span class="text-indigo-400 font-light italic">Pulse</span>
        </span>
    </a>

    {# Section Links - Desktop only #}
    <div class="hidden md:flex items-center gap-1">
        <a href="#hero"         class="nav-link px-4 py-2 text-sm font-semibold text-slate-400 hover:text-white hover:bg-white/5 rounded-xl transition-all">Accueil</a>
        <a href="#features"     class="nav-link px-4 py-2 text-sm font-semibold text-slate-400 hover:text-white hover:bg-white/5 rounded-xl transition-all">Fonctionnalités</a>
        <a href="#courses"      class="nav-link px-4 py-2 text-sm font-semibold text-slate-400 hover:text-white hover:bg-white/5 rounded-xl transition-all">Catalogue</a>
        <a href="#stats"        class="nav-link px-4 py-2 text-sm font-semibold text-slate-400 hover:text-white hover:bg-white/5 rounded-xl transition-all">Statistiques</a>
        <a href="#testimonials" class="nav-link px-4 py-2 text-sm font-semibold text-slate-400 hover:text-white hover:bg-white/5 rounded-xl transition-all">Témoignages</a>
    </div>

    {# Right: Auth Buttons — always visible + Mobile burger #}
    <div class="flex items-center gap-2 md:gap-3">

        {% if app.user %}
            {# Logged in: show dashboard button #}
            <a href="{{ path('app_dashboard') }}" class="flex items-center gap-2 px-4 py-2 md:px-5 md:py-2.5 bg-indigo-500 hover:bg-indigo-400 text-white font-black text-sm rounded-2xl transition-all shadow-lg shadow-indigo-500/20 hover:-translate-y-0.5 active:scale-95">
                <img src="{{ asset('icons/Minimalist_house_icon.png') }}" alt="" class="w-4 h-4 object-contain">
                <span class="hidden sm:inline">Tableau de bord</span>
            </a>
        {% else %}
            {# Not logged in: always-visible Login + Register #}
            <a href="{{ path('app_login') }}" class="px-4 py-2 text-sm font-bold text-slate-300 hover:text-white transition-colors rounded-xl hover:bg-white/5">
                Connexion
            </a>
            <a href="{{ path('app_register') }}" class="px-4 py-2 md:px-5 md:py-2.5 bg-indigo-500 hover:bg-indigo-400 text-white font-black text-sm rounded-2xl transition-all shadow-lg shadow-indigo-500/20 hover:-translate-y-0.5 active:scale-95">
                S'inscrire
            </a>
        {% endif %}

        {# Mobile Burger - only for section links #}
        <button id="landing-menu-btn" class="md:hidden p-2 text-slate-400 hover:text-white rounded-xl hover:bg-white/5 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>
</nav>

{# Mobile Section Links Drawer (auth buttons already in navbar) #}
<div id="landing-mobile-menu" class="fixed inset-x-0 top-20 z-40 hidden md:hidden">
    <div class="mx-4 mt-2 bg-slate-900/98 backdrop-blur-2xl border border-white/10 rounded-3xl shadow-2xl p-4 space-y-1">
        <a href="#hero" class="flex items-center gap-3 px-4 py-3 text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/5 rounded-2xl transition-all">
            <img src="{{ asset('icons/Minimalist_house_icon.png') }}" alt="" class="w-5 h-5 object-contain opacity-60">
            Accueil
        </a>
        <a href="#features" class="flex items-center gap-3 px-4 py-3 text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/5 rounded-2xl transition-all">
            <img src="{{ asset('icons/Library_and_Books_icon.png') }}" alt="" class="w-5 h-5 object-contain opacity-60">
            Fonctionnalités
        </a>
        <a href="#courses" class="flex items-center gap-3 px-4 py-3 text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/5 rounded-2xl transition-all">
            <img src="{{ asset('icons/coursecatloge-.png') }}" alt="" class="w-5 h-5 object-contain opacity-60">
            Catalogue
        </a>
        <a href="#stats" class="flex items-center gap-3 px-4 py-3 text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/5 rounded-2xl transition-all">
            <img src="{{ asset('icons/Group_of_users_icon.png') }}" alt="" class="w-5 h-5 object-contain opacity-60">
            Statistiques
        </a>
        <a href="#testimonials" class="flex items-center gap-3 px-4 py-3 text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/5 rounded-2xl transition-all">
            <img src="{{ asset('icons/messagesSection.png') }}" alt="" class="w-5 h-5 object-contain opacity-60">
            Témoignages
        </a>
    </div>
</div>

<style>
    /* Smooth scroll with offset to account for fixed navbar height */
    html { scroll-behavior: smooth; }
    section[id], div[id] { scroll-margin-top: 5rem; }

    /* Active nav link style */
    .nav-link.active {
        color: white;
        background: rgba(255,255,255,0.08);
    }
</style>

<script>
    // Mobile menu toggle
    document.getElementById('landing-menu-btn').addEventListener('click', function() {
        const menu = document.getElementById('landing-mobile-menu');
        menu.classList.toggle('hidden');
    });

    // Close mobile menu on link click & smooth scroll with navbar offset
    document.querySelectorAll('#landing-mobile-menu a, .nav-link').forEach(link => {
        link.addEventListener('click', (e) => {
            const href = link.getAttribute('href');
            if (href && href.startsWith('#')) {
                e.preventDefault();
                document.getElementById('landing-mobile-menu').classList.add('hidden');
                const target = document.querySelector(href);
                if (target) {
                    const offset = 80; // navbar height
                    const top = target.getBoundingClientRect().top + window.scrollY - offset;
                    window.scrollTo({ top, behavior: 'smooth' });
                }
            }
        });
    });

    // Highlight active nav link on scroll
    const sections = document.querySelectorAll('section[id], div[id]');
    const navLinks = document.querySelectorAll('.nav-link');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                navLinks.forEach(link => {
                    link.classList.remove('active');
                    if (link.getAttribute('href') === '#' + entry.target.id) {
                        link.classList.add('active');
                    }
                });
            }
        });
    }, { rootMargin: '-30% 0px -60% 0px' });

    sections.forEach(section => observer.observe(section));
</script>

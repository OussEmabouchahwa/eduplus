{% extends 'base_dashboard.html.twig' %}

{% block title %}EduPulse | Éditer Groupe{% endblock %}
{% block page_title %}Éditer le Groupe{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto space-y-6 animate-fade-in">
    <div class="flex justify-between items-center">
        <h1 class="text-2xl font-bold text-white">Éditer: {{ course.title }}</h1>
        <a href="{{ path('app_chat_room', {'courseId': course.id}) }}" class="text-slate-400 hover:text-white transition-colors text-sm flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Retour au Chat
        </a>
    </div>

    <div class="glass-card p-8">
        {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}
            
            <div>
                {{ form_label(form.title, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-300 mb-2'}}) }}
                {{ form_widget(form.title, {'attr': {'class': 'w-full bg-slate-800/50 border border-slate-600 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all shadow-inner'}}) }}
                <div class="text-red-400 text-xs mt-1">{{ form_errors(form.title) }}</div>
            </div>

            <div>
                {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-300 mb-2'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'w-full bg-slate-800/50 border border-slate-600 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all shadow-inner'}}) }}
                <div class="text-red-400 text-xs mt-1">{{ form_errors(form.description) }}</div>
            </div>

            <div>
                {{ form_label(form.imageFile, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-300 mb-2'}}) }}
                {{ form_widget(form.imageFile, {'attr': {'class': 'w-full text-sm text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-600 hover:file:bg-indigo-100 transition-all'}}) }}
                <div class="text-red-400 text-xs mt-1">{{ form_errors(form.imageFile) }}</div>
            </div>

            <div class="pt-4 flex justify-end">
                <button class="px-6 py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl transition-all shadow-lg shadow-indigo-500/20">
                    Mettre à jour
                </button>
            </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

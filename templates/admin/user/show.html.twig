{% extends 'base_dashboard.html.twig' %}
{% block title %}{{ user.fullName }} | EduPulse{% endblock %}
{% block page_title %}Profil Utilisateur{% endblock %}

{% block body %}
<div class="animate-fade-in max-w-3xl mx-auto">

    {# Back Button #}
    <a href="{{ path('app_admin_user_index') }}" style="display:inline-flex;align-items:center;gap:8px;color:#94a3b8;font-size:14px;text-decoration:none;margin-bottom:24px;transition:color 0.2s" onmouseover="this.style.color='#f1f5f9'" onmouseout="this.style.color='#94a3b8'">
        ← Retour à la liste
    </a>

    {# Profile Card #}
    <div style="background:rgba(15,23,42,0.7);border:1px solid rgba(255,255,255,0.07);border-radius:24px;overflow:hidden;backdrop-filter:blur(20px)">

        {# Hero Banner #}
        <div style="height:120px;background:linear-gradient(135deg, rgba(99,102,241,0.4) 0%, rgba(6,182,212,0.4) 100%);position:relative">
            {# Avatar #}
            <div style="position:absolute;bottom:-48px;left:32px;width:96px;height:96px;border-radius:50%;border:4px solid #0f172a;overflow:hidden;background:#1e293b;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:800;color:#94a3b8">
                {% if user.profilePhoto %}
                    <img src="{{ asset('uploads/profiles/' ~ user.profilePhoto) }}" alt="" style="width:100%;height:100%;object-fit:cover" onerror="this.style.display='none'">
                {% endif %}
                {% if not user.profilePhoto %}{{ user.firstName|first }}{{ user.lastName|first }}{% endif %}
            </div>
        </div>

        {# Info Section #}
        <div style="padding:64px 32px 32px">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:16px">
                <div>
                    <h1 style="font-size:24px;font-weight:800;color:#f1f5f9;margin:0 0 4px">{{ user.fullName }}</h1>
                    <div style="color:#94a3b8;font-size:14px">{{ user.email }}</div>
                    {% set roles = user.roles %}
                    <div style="margin-top:8px">
                        {% if 'ROLE_ADMIN' in roles %}
                            <span style="padding:3px 12px;border-radius:999px;background:rgba(168,85,247,0.15);border:1px solid rgba(168,85,247,0.3);color:#c084fc;font-size:11px;font-weight:700">👑 Administrateur</span>
                        {% elseif 'ROLE_TEACHER' in roles %}
                            <span style="padding:3px 12px;border-radius:999px;background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.3);color:#34d399;font-size:11px;font-weight:700">🎓 Formateur</span>
                        {% else %}
                            <span style="padding:3px 12px;border-radius:999px;background:rgba(6,182,212,0.15);border:1px solid rgba(6,182,212,0.3);color:#22d3ee;font-size:11px;font-weight:700">👤 Étudiant</span>
                        {% endif %}
                    </div>
                </div>
                <a href="{{ path('app_admin_user_edit', {id: user.id}) }}" style="padding:10px 20px;border-radius:12px;background:rgba(99,102,241,0.2);border:1px solid rgba(99,102,241,0.3);color:#818cf8;font-size:13px;font-weight:600;text-decoration:none;transition:all 0.2s" onmouseover="this.style.background='rgba(99,102,241,0.35)'" onmouseout="this.style.background='rgba(99,102,241,0.2)'">
                    ✏️ Modifier le profil
                </a>
            </div>

            {# Detail Grid #}
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:32px">
                {% set fields = [
                    { label: '📞 Téléphone', value: user.phone ?? 'Non renseigné' },
                    { label: '📚 Cours inscrits', value: user.enrolledCourses|length ~ ' cours' },
                ] %}
                {% for field in fields %}
                <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:16px">
                    <div style="font-size:11px;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px">{{ field.label }}</div>
                    <div style="color:#f1f5f9;font-size:15px;font-weight:600">{{ field.value }}</div>
                </div>
                {% endfor %}
            </div>

            {# Bio #}
            {% if user.bio %}
            <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:16px;margin-top:16px">
                <div style="font-size:11px;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">📝 Biographie</div>
                <div style="color:#cbd5e1;font-size:14px;line-height:1.6">{{ user.bio }}</div>
            </div>
            {% endif %}

            {# Enrolled Courses #}
            {% if user.enrolledCourses|length > 0 %}
            <div style="margin-top:24px">
                <div style="font-size:11px;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px">📋 Cours Inscrits</div>
                <div style="display:flex;flex-wrap:wrap;gap:8px">
                    {% for course in user.enrolledCourses %}
                        <span style="padding:4px 12px;border-radius:8px;background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.2);color:#a5b4fc;font-size:12px;font-weight:600">
                            {{ course.title }}
                        </span>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# Delete button #}
            {% if user.id != app.user.id %}
            <div style="margin-top:32px;padding-top:24px;border-top:1px solid rgba(255,255,255,0.05)">
                <form method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                    <button type="submit" style="padding:10px 20px;border-radius:12px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);color:#f87171;font-size:13px;font-weight:600;cursor:pointer;transition:all 0.2s" onmouseover="this.style.background='rgba(239,68,68,0.25)'" onmouseout="this.style.background='rgba(239,68,68,0.1)'">
                        🗑 Supprimer cet utilisateur
                    </button>
                </form>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

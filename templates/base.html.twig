<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EduPulse{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
    
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
    
    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>

<body class="{% block body_class %}bg-[#020617] text-slate-200{% endblock %} font-sans antialiased selection:bg-indigo-500 selection:text-white">

    {# Landing Navbar - Links to page sections + Login/Register #}
    {% block navbar %}
        {{ include('partials/_navbar_landing.html.twig') }}
    {% endblock %}

    {# Page Content #}
    <main class="{% block main_class %}{% endblock %}">
        {% block body %}{% endblock %}
    </main>

</body>
</html>
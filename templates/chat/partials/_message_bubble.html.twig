{% set isMe = message.author == app.user %}
<div class="flex {{ isMe ? 'justify-end' : 'justify-start' }} animate-fade-in group/msg relative">
    
    {# Avatar for others #}
    {% if not isMe %}
        <div class="w-10 h-10 rounded-2xl overflow-hidden mr-3 mt-auto border border-white/10 flex-shrink-0 shadow-2xl transition-transform group-hover/msg:scale-110">
            {% if message.author.profilePhoto %}
                <img src="{{ asset('uploads/profiles/' ~ message.author.profilePhoto) }}" alt="Photo" class="w-full h-full object-cover">
            {% else %}
                <div class="w-full h-full bg-slate-800 flex items-center justify-center text-[10px] text-slate-400 font-black uppercase">
                    {{ message.author.firstName|first }}{{ message.author.lastName|first }}
                </div>
            {% endif %}
        </div>
    {% endif %}

    <div class="flex flex-col {{ isMe ? 'items-end' : 'items-start' }} max-w-[80%] md:max-w-[70%] lg:max-w-[60%]">
        {% if not isMe %}
            <span class="text-[11px] text-slate-500 font-black uppercase tracking-widest ml-2 mb-2 opacity-70 group-hover/msg:opacity-100 transition-opacity">
                {{ message.author.firstName }} {{ message.author.lastName }}
            </span>
        {% endif %}
        
        <div class="relative {{ isMe ? 'bg-gradient-to-br from-indigo-600 via-indigo-600 to-violet-700 text-white shadow-2xl shadow-indigo-600/30 rounded-[2rem] rounded-br-lg' : 'bg-slate-900/80 backdrop-blur-2xl text-slate-200 border border-white/10 shadow-xl rounded-[2rem] rounded-bl-lg' }} p-5 px-6 transition-all hover:translate-y-[-2px] duration-500 ease-out group-hover/msg:shadow-indigo-500/20">
            <p class="text-[15px] leading-relaxed font-medium selection:bg-white/20">{{ message.content }}</p>
            
            {# Dynamic Glow for My Messages #}
            {% if isMe %}
                <div class="absolute inset-0 rounded-[2rem] rounded-br-lg bg-white/10 opacity-0 group-hover/msg:opacity-100 transition-opacity pointer-events-none"></div>
            {% endif %}
        </div>
        
        <div class="flex items-center gap-3 mt-2.5 mx-3 opacity-40 group-hover/msg:opacity-100 transition-all duration-500">
            <span class="text-[9px] text-slate-400 font-black uppercase tracking-[0.2em]">{{ message.createdAt|date('H:i') }}</span>
            {% if isMe %}
                <div class="flex items-center -space-x-1">
                    <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                    <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                </div>
            {% endif %}
        </div>
    </div>
</div>

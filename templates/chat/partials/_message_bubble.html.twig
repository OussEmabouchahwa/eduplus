{% set isMe = message.author == app.user %}
<div class="flex {{ isMe ? 'justify-end' : 'justify-start' }} animate-fade-in group/msg relative">
    <div class="flex {{ isMe ? 'flex-row-reverse' : 'flex-row' }} items-start gap-3 max-w-[85%] md:max-w-[70%] lg:max-w-[65%]">
    
    {# Avatar #}
    <div class="flex-shrink-0 pt-0.5">
        <div class="w-10 h-10 rounded-full overflow-hidden border border-white/10 shadow-lg transition-transform group-hover/msg:scale-105 bg-slate-800 flex items-center justify-center ring-2 ring-white/5">
            {% if message.author.profilePhoto %}
                <img src="{{ asset('uploads/profiles/' ~ message.author.profilePhoto) }}" alt="Photo" class="w-full h-full object-cover">
            {% else %}
                <span class="text-[11px] text-slate-400 font-bold uppercase">
                    {{ message.author.firstName|first }}{{ message.author.lastName|first }}
                </span>
            {% endif %}
        </div>
    </div>

    {# Content Column: Name/Time row + Bubble row #}
    <div class="flex flex-col {{ isMe ? 'items-end' : 'items-start' }} min-w-0">
        {# Top Row: Name + Timestamp side-by-side #}
        <div class="flex items-baseline gap-2 mb-1 {{ isMe ? 'flex-row-reverse' : '' }}">
            <span class="text-[13px] font-bold text-white leading-none">
                {{ isMe ? 'Vous' : message.author.firstName ~ ' ' ~ message.author.lastName }}
            </span>
            <span class="text-[11px] text-slate-500 font-medium leading-none">
                {{ message.createdAt|date('H:i') }}
            </span>
        </div>
        
        {# Bottom Row: Chat Bubble #}
        <div class="relative {{ isMe ? 'bg-indigo-600/90 text-white' : 'bg-slate-800/80 text-slate-200 border border-white/[0.06]' }} px-4 py-2.5 rounded-2xl {{ isMe ? 'rounded-tr-md' : 'rounded-tl-md' }} shadow-lg backdrop-blur-sm max-w-xl transition-all duration-300">
            {% if message.attachmentPath %}
                {% if message.attachmentType starts with 'image/' %}
                    <div class="mb-3 rounded-lg overflow-hidden border border-white/10 shadow-sm">
                        <a href="{{ asset('uploads/chat/' ~ message.attachmentPath) }}" target="_blank">
                            <img src="{{ asset('uploads/chat/' ~ message.attachmentPath) }}" class="max-w-full max-h-64 object-cover hover:scale-105 transition-transform duration-500" alt="Attachment">
                        </a>
                    </div>
                {% else %}
                    <a href="{{ asset('uploads/chat/' ~ message.attachmentPath) }}" target="_blank" class="flex items-center gap-3 mb-3 p-3 bg-black/10 rounded-lg border border-white/5 hover:bg-black/20 transition-all group/file">
                        <div class="w-10 h-10 bg-indigo-500/20 rounded-lg flex items-center justify-center text-indigo-400">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-xs font-bold text-white truncate">{{ message.attachmentName }}</p>
                            <p class="text-[9px] text-slate-400 uppercase font-bold tracking-wider">{{ message.attachmentType|split('/')|last }}</p>
                        </div>
                    </a>
                {% endif %}
            {% endif %}
            <p class="text-[14px] leading-relaxed font-medium whitespace-pre-wrap break-words">{{ message.content }}</p>
            
            {# Subtle checkmarks for my messages #}
            {% if isMe %}
                <div class="flex justify-end mt-1 -mb-0.5">
                    <div class="flex items-center -space-x-1 opacity-50">
                        <svg class="w-3.5 h-3.5 text-indigo-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        <svg class="w-3.5 h-3.5 text-indigo-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
    </div>
</div>

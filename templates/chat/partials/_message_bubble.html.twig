{% set isMe = message.author == app.user %}
<div class="flex {{ isMe ? 'justify-end' : 'justify-start' }} animate-fade-in group/msg">
    
    {# Avatar for others #}
    {% if not isMe %}
        <div class="w-10 h-10 rounded-2xl overflow-hidden mr-4 mt-auto border border-white/10 flex-shrink-0 shadow-lg">
            {% if message.author.profilePhoto %}
                <img src="{{ asset('uploads/profiles/' ~ message.author.profilePhoto) }}" alt="Photo" class="w-full h-full object-cover">
            {% else %}
                <div class="w-full h-full bg-slate-800 flex items-center justify-center text-[10px] text-slate-400 font-bold uppercase">
                    {{ message.author.firstName|first }}{{ message.author.lastName|first }}
                </div>
            {% endif %}
        </div>
    {% endif %}

    <div class="flex flex-col {{ isMe ? 'items-end' : 'items-start' }} max-w-[75%]">
        {% if not isMe %}
            <span class="text-[11px] text-slate-500 font-bold ml-1 mb-1.5">{{ message.author.firstName }} {{ message.author.lastName }}</span>
        {% endif %}
        
        <div class="{{ isMe ? 'bg-indigo-600 text-white shadow-xl shadow-indigo-600/20 rounded-3xl rounded-br-lg' : 'bg-white/10 backdrop-blur-md text-slate-200 border border-white/5 shadow-xl rounded-3xl rounded-bl-lg' }} p-5 transition-all hover:scale-[1.01] duration-300">
            <p class="text-[15.5px] leading-relaxed font-medium">{{ message.content }}</p>
        </div>
        
        <div class="flex items-center gap-2 mt-2 mx-2">
            <span class="text-[10px] text-slate-600 font-bold uppercase tracking-widest">{{ message.createdAt|date('H:i') }}</span>
            {% if isMe %}
                <svg class="w-3 h-3 text-indigo-400" fill="currentColor" viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"></path></svg>
            {% endif %}
        </div>
    </div>
</div>

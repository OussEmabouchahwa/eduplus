{# Left Sidebar: Conversations List (Professional Dark) #}
<div class="w-80 flex-shrink-0 bg-slate-900/60 backdrop-blur-3xl border-r border-white/[0.06] flex flex-col z-20">
    {# Header #}
    <div class="h-20 px-6 border-b border-white/[0.06] flex items-center justify-between bg-slate-900/40">
        <h1 class="text-[15px] font-bold text-white tracking-tight">Salons</h1>
        <span class="bg-white/[0.06] text-slate-400 px-2.5 py-0.5 rounded-md text-[11px] font-semibold tabular-nums">
            {{ courses|length }}
        </span>
    </div>
    
    {# Search in Sidebar #}
    <div class="px-4 py-3">
        <div class="relative group">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                <svg class="w-4 h-4 text-slate-600 group-focus-within:text-slate-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <input type="text" placeholder="Rechercher..." class="w-full bg-white/[0.03] border-none rounded-lg py-2 pl-10 pr-4 text-[13px] text-slate-300 placeholder-slate-600 focus:outline-none focus:bg-white/[0.06] transition-all">
        </div>
    </div>

    {# Section Label #}
    <div class="px-5 pt-1 pb-2">
        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.15em]">Cours inscrits</p>
    </div>
    
    {# Conversations List #}
    <div class="flex-1 overflow-y-auto px-3 pb-6 space-y-0.5 custom-scrollbar">
        {% for course in courses %}
            <a href="{{ path('app_chat_room', {'courseId': course.id}) }}" 
               class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group relative
                      {% if course.id == activeCourse.id %}
                          bg-indigo-500/10 shadow-sm
                      {% else %}
                          hover:bg-white/[0.04]
                      {% endif %}">
                
                {# Active Indicator Bar #}
                {% if course.id == activeCourse.id %}
                    <div class="absolute left-0 top-1/2 -translate-y-1/2 w-[3px] h-5 bg-indigo-500 rounded-r-full shadow-sm shadow-indigo-500/50"></div>
                {% endif %}

                {# Course Avatar #}
                <div class="relative w-10 h-10 flex-shrink-0 rounded-xl overflow-hidden shadow-md group-hover:shadow-lg transition-all duration-300 ring-1 {% if course.id == activeCourse.id %}ring-indigo-500/30{% else %}ring-white/[0.06] group-hover:ring-white/10{% endif %}">
                    <div class="w-full h-full bg-gradient-to-br from-slate-800 to-slate-900 flex items-center justify-center text-slate-500 font-bold text-sm absolute inset-0 uppercase">
                        {{ course.title|first }}
                    </div>
                    {% if course.imagePath %}
                        {% set chatImgSrc = course.imagePath starts with 'courses/' ? asset('images/' ~ course.imagePath) : asset('uploads/courses/' ~ course.imagePath) %}
                        <img src="{{ chatImgSrc }}" alt="" class="w-full h-full object-cover absolute inset-0 z-10 group-hover:scale-110 transition-transform duration-500">
                    {% endif %}
                </div>
                
                {# Course Info #}
                <div class="flex-1 min-w-0">
                    <h3 class="text-[13px] font-semibold truncate leading-snug transition-colors duration-200
                               {% if course.id == activeCourse.id %}text-white{% else %}text-slate-400 group-hover:text-slate-200{% endif %}">
                        {{ course.title }}
                    </h3>
                    <div class="flex items-center gap-1.5 mt-0.5">
                        <svg class="w-3 h-3 flex-shrink-0 {% if course.id == activeCourse.id %}text-indigo-400/60{% else %}text-slate-600{% endif %}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                        <span class="text-[11px] {% if course.id == activeCourse.id %}text-indigo-300/60{% else %}text-slate-600{% endif %} font-medium">{{ course.students|length }} étudiants</span>
                    </div>
                </div>

                {# Active dot / Hover chevron #}
                <div class="flex-shrink-0">
                    {% if course.id == activeCourse.id %}
                        <div class="w-2 h-2 bg-indigo-400 rounded-full shadow-sm shadow-indigo-400/50 animate-pulse"></div>
                    {% else %}
                        <svg class="w-4 h-4 text-slate-700 opacity-0 group-hover:opacity-100 transition-opacity duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    {% endif %}
                </div>
            </a>
        {% else %}
            <div class="text-center p-10 mt-10">
                <div class="w-16 h-16 bg-white/[0.03] rounded-2xl flex items-center justify-center mx-auto mb-5 border border-white/[0.06]">
                    <svg class="w-8 h-8 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                </div>
                <p class="text-[13px] text-slate-600 font-medium">Aucune discussion disponible.</p>
            </div>
        {% endfor %}
    </div>
</div>

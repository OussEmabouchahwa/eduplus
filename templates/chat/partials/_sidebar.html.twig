{# Left Sidebar: Conversations List (Glassmorphism) #}
<div class="w-80 flex-shrink-0 bg-slate-900/40 backdrop-blur-3xl border-r border-white/5 flex flex-col z-20">
    <div class="h-20 px-6 border-b border-white/5 flex items-center justify-between bg-white/5">
        <h1 class="text-xl font-black text-white tracking-tighter uppercase italic">Messages</h1>
        <div class="flex items-center gap-2">
            <span class="bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest">
                {{ courses|length }} SALONS
            </span>
        </div>
    </div>
    
    {# Search in Sidebar #}
    <div class="p-5">
        <div class="relative group">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-slate-500 group-focus-within:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <input type="text" placeholder="Filtrer vos cours..." class="w-full bg-slate-950/40 border border-white/5 rounded-2xl py-3 pl-12 pr-4 text-sm text-slate-300 placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 transition-all shadow-inner">
        </div>
    </div>
    
    <div class="flex-1 overflow-y-auto px-4 pb-6 space-y-2 custom-scrollbar">
        {% for course in courses %}
            <a href="{{ path('app_chat_room', {'courseId': course.id}) }}" 
               class="flex items-center gap-4 p-3.5 rounded-2xl transition-all group relative overflow-hidden {% if course.id == activeCourse.id %}bg-indigo-500/15 border border-indigo-500/30 shadow-lg shadow-indigo-500/5{% else %}hover:bg-white/5 border border-transparent{% endif %}">
                
                {% if course.id == activeCourse.id %}
                    <div class="absolute left-0 top-0 bottom-0 w-1 bg-indigo-500 rounded-full my-4"></div>
                {% endif %}
                
                {# Course Avatar #}
                <div class="relative w-12 h-12 flex-shrink-0 rounded-2xl overflow-hidden shadow-xl group-hover:scale-110 transition-transform duration-500 ease-out">
                    <div class="w-full h-full bg-gradient-to-br from-slate-800 to-slate-900 flex items-center justify-center text-slate-500 font-black text-lg absolute inset-0 uppercase tracking-tighter">
                        {{ course.title|first }}
                    </div>
                    {% if course.imagePath %}
                        {% set chatImgSrc = course.imagePath starts with 'courses/' ? asset('images/' ~ course.imagePath) : asset('uploads/courses/' ~ course.imagePath) %}
                        <img src="{{ chatImgSrc }}" alt="" class="w-full h-full object-cover absolute inset-0 z-10 opacity-90 group-hover:opacity-100 transition-opacity" onerror="this.style.display='none'">
                    {% endif %}
                    <div class="absolute bottom-0 right-0 w-3.5 h-3.5 bg-emerald-500 border-2 border-slate-900 rounded-full z-20 shadow-sm shadow-emerald-500/50"></div>
                </div>
                
                <div class="flex-1 min-w-0">
                    <div class="flex justify-between items-start mb-0.5">
                        <h3 class="text-[15px] font-bold {% if course.id == activeCourse.id %}text-white{% else %}text-slate-300 group-hover:text-white{% endif %} truncate transition-colors leading-tight">
                            {{ course.title }}
                        </h3>
                    </div>
                    <div class="flex items-center gap-1.5 mt-1">
                        <div class="flex -space-x-2">
                            <div class="w-4 h-4 rounded-full bg-slate-700 border border-slate-900"></div>
                            <div class="w-4 h-4 rounded-full bg-slate-600 border border-slate-900"></div>
                        </div>
                        <p class="text-[10px] text-slate-500 truncate font-black uppercase tracking-widest">
                             {{ course.students|length }} élèves
                        </p>
                    </div>
                </div>
            </a>
        {% else %}
            <div class="text-center p-10 mt-10">
                <div class="w-20 h-20 bg-white/5 rounded-[2rem] flex items-center justify-center mx-auto mb-6 rotate-12 border border-white/5">
                    <svg class="w-10 h-10 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                </div>
                <p class="text-[13px] text-slate-500 font-medium">Aucune discussion disponible.</p>
            </div>
        {% endfor %}
    </div>
</div>


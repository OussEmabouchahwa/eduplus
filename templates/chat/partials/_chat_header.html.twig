{# Chat Header (Premium Glass) #}
<div class="h-20 px-8 border-b border-white/5 bg-slate-950/40 backdrop-blur-xl flex items-center justify-between z-30 shadow-sm">
    <div class="flex items-center gap-5">
        <div class="relative w-12 h-12 rounded-2xl overflow-hidden border border-white/10 shadow-2xl group cursor-pointer">
            <div class="w-full h-full bg-slate-800 flex items-center justify-center text-slate-400 font-bold absolute inset-0">
                {{ activeCourse.title|first }}
            </div>
            {% if activeCourse.imagePath %}
                {% set activeImgSrc = activeCourse.imagePath starts with 'courses/' ? asset('images/' ~ activeCourse.imagePath) : asset('uploads/courses/' ~ activeCourse.imagePath) %}
                <img src="{{ activeImgSrc }}" alt="" class="w-full h-full object-cover absolute inset-0 z-10 group-hover:scale-110 transition-transform duration-500">
            {% endif %}
        </div>
        <div>
            <h2 class="text-[17px] font-black text-white tracking-tight leading-tight">{{ activeCourse.title }}</h2>
            <div class="flex items-center gap-2 mt-0.5">
                <span class="flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <span class="text-[11px] font-bold text-emerald-500/80 uppercase tracking-widest">Discussion de classe</span>
            </div>
        </div>
    </div>
    
    <div class="flex items-center gap-4">
        <button class="p-2.5 rounded-xl bg-white/5 text-slate-400 hover:text-white hover:bg-white/10 transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </button>
        {% if is_granted('ROLE_ADMIN') or activeCourse.teacher == app.user %}
            <a href="{{ path('app_admin_course_edit', {'id': activeCourse.id}) }}" class="px-5 py-2.5 rounded-xl bg-indigo-500 hover:bg-indigo-400 text-white shadow-lg shadow-indigo-500/20 transition-all text-xs font-black uppercase tracking-wider">
                Paramètres
            </a>
        {% endif %}
    </div>
</div>

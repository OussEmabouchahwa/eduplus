{% extends 'base_dashboard.html.twig' %}

{% block title %}Messages | EduPulse{% endblock %}

{% block content_wrapper %}
<div class="h-[calc(100vh-5rem)] flex overflow-hidden w-full bg-slate-950/20">
    
    {# --- Left Sidebar: Conversations List --- #}
    {{ include('chat/partials/_sidebar.html.twig') }}

    {# --- Main Area: Active Chat --- #}
    <div class="flex-1 flex flex-col relative overflow-hidden bg-[#0f172a]">
        {# Chat Header #}
        {{ include('chat/partials/_chat_header.html.twig') }}

        {# --- Chat Messages Zone --- #}
        <div id="chat-messages-container" 
             class="flex-1 overflow-y-auto p-6 space-y-5 z-10 custom-scrollbar relative"
             data-controller="chat"
             data-chat-course-id-value="{{ activeCourse.id }}"
             data-chat-hub-url-value="{{ mercure('https://edupulse.com/chat/' ~ activeCourse.id)|default('http://localhost:3000/.well-known/mercure') }}"
             data-chat-current-user-value="{{ app.user.userIdentifier }}">
            
            {# Background glows restricted to message zone but subtle #}
            <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-indigo-500/5 blur-[120px] rounded-full pointer-events-none z-0"></div>
            <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-blue-500/5 blur-[100px] rounded-full pointer-events-none z-0"></div>

            <div data-chat-target="container" class="space-y-4 relative z-10">
                {% for message in messages %}
                    {{ include('chat/partials/_message_bubble.html.twig') }}
                {% else %}
                    <div class="flex flex-col items-center justify-center h-full text-center py-20">
                        <div class="w-24 h-24 rounded-full bg-white/5 flex items-center justify-center text-slate-700 mb-6 border border-white/5 animate-pulse">
                            <img src="{{ asset('icons/messagesSection.png') }}" alt="Empty" class="w-12 h-12 opacity-20 grayscale">
                        </div>
                        <h4 class="text-white font-bold text-lg mb-2">Bienvenue dans le salon</h4>
                        <p class="text-slate-500 text-sm max-w-xs mx-auto">C'est le début de l'aventure ! Envoyez un message pour briser la glace avec vos collègues.</p>
                    </div>
                {% endfor %}
            </div>

            {# --- Chat Input (Floating Pill) --- #}
            {{ include('chat/partials/_chat_input.html.twig') }}
        </div>
    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 5px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.05); border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(99,102,241,0.2); }
</style>
{% endblock %}

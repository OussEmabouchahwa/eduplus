{% extends 'base_dashboard.html.twig' %}

{% block title %}Messages | EduPulse{% endblock %}

{% block content_wrapper %}
<div class="h-[calc(100vh-5rem)] flex overflow-hidden w-full">
    
    {# Left Sidebar: Conversations List #}
    <div class="w-80 flex-shrink-0 bg-slate-900/80 border-r border-slate-700/50 flex flex-col z-10 backdrop-blur-md">
        <div class="p-4 border-b border-slate-700/50 flex items-center justify-between">
            <h1 class="text-xl font-bold text-white">Discussions</h1>
            <span class="text-xs bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 px-2 py-1 rounded-full font-bold">
                {{ courses|length }}
            </span>
        </div>
        
        <div class="flex-1 overflow-y-auto p-3 space-y-2 scrollbar-thin scrollbar-thumb-slate-700 scrollbar-track-transparent">
            {% for course in courses %}
                <a href="{{ path('app_chat_room', {'courseId': course.id}) }}" 
                   class="flex items-center gap-3 p-3 rounded-xl transition-all group {% if course.id == activeCourse.id %}bg-indigo-600/20 border border-indigo-500/30 shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}hover:bg-slate-800 border border-transparent{% endif %}">
                    
                    {# Course Avatar #}
                    <div class="relative w-12 h-12 flex-shrink-0 rounded-full overflow-hidden border border-slate-600/50">
                        <div class="w-full h-full bg-slate-800 flex items-center justify-center text-slate-400 font-bold absolute inset-0">
                            {{ course.title|first }}
                        </div>
                        {% if course.imagePath %}
                            {% set chatImgSrc = course.imagePath starts with 'courses/' ? asset('images/' ~ course.imagePath) : asset('uploads/courses/' ~ course.imagePath) %}
                            <img src="{{ chatImgSrc }}" alt="" class="w-full h-full object-cover absolute inset-0 z-10" onerror="this.style.display='none'">
                        {% endif %}
                        <div class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 border-2 border-slate-900 rounded-full z-20"></div>
                    </div>
                    
                    <div class="flex-1 overflow-hidden">
                        <h3 class="text-sm font-bold text-white truncate group-hover:text-indigo-400 transition-colors">
                            {{ course.title }}
                        </h3>
                        <p class="text-xs text-slate-400 truncate mt-0.5">
                            {{ course.students|length }} membres
                        </p>
                    </div>
                </a>
            {% else %}
                <div class="text-center p-4 text-sm text-slate-500">
                    Aucune discussion disponible.
                </div>
            {% endfor %}
        </div>
    </div>

    {# Main Area: Active Chat #}
    <div class="flex-1 flex flex-col bg-slate-900 relative">
        {# Decorator background #}
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-indigo-900/20 via-slate-900/0 to-slate-900/0 pointer-events-none"></div>

        {# Chat Header #}
        <div class="h-20 p-4 border-b border-slate-700/50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-between z-10">
            <div class="flex items-center gap-4">
                <div class="relative w-12 h-12 rounded-full overflow-hidden border border-indigo-500/30">
                    <div class="w-full h-full bg-slate-800 flex items-center justify-center text-slate-400 font-bold absolute inset-0">
                        {{ activeCourse.title|first }}
                    </div>
                    {% if activeCourse.imagePath %}
                        {% set activeImgSrc = activeCourse.imagePath starts with 'courses/' ? asset('images/' ~ activeCourse.imagePath) : asset('uploads/courses/' ~ activeCourse.imagePath) %}
                        <img src="{{ activeImgSrc }}" alt="" class="w-full h-full object-cover absolute inset-0 z-10" onerror="this.style.display='none'">
                    {% endif %}
                </div>
                <div>
                    <h2 class="text-lg font-bold text-white">{{ activeCourse.title }}</h2>
                    <p class="text-xs text-indigo-400 flex items-center gap-1.5">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                        </span>
                        En ligne
                    </p>
                </div>
            </div>
            
            <div class="flex items-center gap-3">
                {% if is_granted('ROLE_ADMIN') or activeCourse.teacher == app.user %}
                    <a href="{{ path('app_admin_course_edit', {'id': activeCourse.id}) }}" class="px-4 py-2 rounded-lg bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 hover:bg-indigo-500/20 hover:text-indigo-300 transition-colors text-sm font-bold flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                        Éditer le Groupe
                    </a>
                {% endif %}
            </div>
        </div>

        {# Chat Messages Zone #}
        <div class="flex-1 overflow-y-auto p-6 space-y-6 z-10 scrollbar-thin scrollbar-thumb-indigo-600/50 scrollbar-track-transparent"
             data-controller="chat"
             data-chat-course-id-value="{{ activeCourse.id }}"
             data-chat-hub-url-value="{{ mercure('https://edupulse.com/chat/' ~ activeCourse.id)|default('http://localhost:3000/.well-known/mercure') }}"
             data-chat-current-user-value="{{ app.user.userIdentifier }}">
            
            <div data-chat-target="container" class="space-y-4">
                {% for message in messages %}
                    {% set isMe = message.author == app.user %}
                    <div class="flex {{ isMe ? 'justify-end' : 'justify-start' }} animate-fade-in group/msg">
                        
                        {# Author Photo for Others #}
                        {% if not isMe %}
                            <div class="w-8 h-8 rounded-full overflow-hidden mr-2 mt-auto border border-slate-600/50 flex-shrink-0">
                                {% if message.author.profilePhoto %}
                                    <img src="{{ asset('uploads/profiles/' ~ message.author.profilePhoto) }}" alt="Photo" class="w-full h-full object-cover">
                                {% else %}
                                    <div class="w-full h-full bg-slate-700 flex items-center justify-center text-[10px] text-slate-300 font-bold uppercase">
                                        {{ message.author.firstName|first }}{{ message.author.lastName|first }}
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}

                        <div class="flex flex-col {{ isMe ? 'items-end' : 'items-start' }} max-w-[70%]">
                            {% if not isMe %}
                                <span class="text-[10px] text-slate-400 font-semibold ml-1 mb-1">{{ message.author.firstName }} {{ message.author.lastName }}</span>
                            {% endif %}
                            
                            <div class="{{ isMe ? 'bg-indigo-600 text-white rounded-2xl rounded-br-sm' : 'bg-slate-800 text-slate-200 border border-slate-700/50 rounded-2xl rounded-bl-sm' }} p-3.5 shadow-md relative group-hover/msg:shadow-lg transition-all">
                                <p class="text-sm leading-relaxed">{{ message.content }}</p>
                            </div>
                            
                            <span class="text-[10px] text-slate-500 mt-1 mx-1">{{ message.createdAt|date('H:i') }}</span>
                        </div>
                    </div>
                {% else %}
                    <div class="flex flex-col items-center justify-center h-full text-slate-500 py-20">
                        <div class="w-16 h-16 rounded-full bg-slate-800 flex items-center justify-center text-slate-600 mb-4">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                        </div>
                        <p class="italic">C'est le début de la conversation. Soyez le premier à envoyer un message !</p>
                    </div>
                {% endfor %}
            </div>

            {# Chat Input #}
            <div class="sticky bottom-0 mt-6 pt-4 bg-gradient-to-t from-slate-900 via-slate-900 to-transparent">
                <form class="flex items-end gap-3" data-action="submit->chat#submit">
                    <div class="flex-1 relative">
                        <textarea rows="1" 
                               data-chat-target="input"
                               placeholder="Écrivez un message à la classe..." 
                               class="w-full bg-slate-800/80 backdrop-blur border border-slate-600 text-white placeholder-slate-400 rounded-2xl px-5 py-3.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all shadow-inner resize-none min-h-[52px] max-h-[150px] overflow-y-auto"
                               style="field-sizing: content;"
                               onkeydown="if(event.keyCode == 13 && !event.shiftKey) { event.preventDefault(); this.form.dispatchEvent(new Event('submit', {cancelable: true, bubbles: true})); }"></textarea>
                    </div>
                    
                    <button type="submit" class="w-14 h-[52px] flex-shrink-0 rounded-2xl bg-indigo-600 hover:bg-indigo-500 transition-all text-white flex items-center justify-center shadow-lg shadow-indigo-600/30 group">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform group-hover:scale-110 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                        </svg>
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>
{% endblock %}

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EduPulse | Console{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
    
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
    
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
        {{ include('dashboard/partials/_head_assets.html.twig') }}
    {% endblock %}
</head>

<body class="dashboard-layout bg-edu-slate text-slate-200 h-screen overflow-hidden flex font-sans antialiased selection:bg-edu-indigo selection:text-white">

    {# Sidebar Partial #}
    {{ include('dashboard/partials/_sidebar.html.twig') }}

    <div id="main-wrapper" class="bg-edu-slate relative z-10 w-full flex flex-col">
        
        {# Header Area #}
        <header class="h-20 border-b border-white/5 bg-slate-950/80 backdrop-blur-2xl flex items-center justify-start px-8 md:px-12 relative z-[100] flex-shrink-0 shadow-sm gap-8">
             <div class="flex items-center gap-6">
                {# Sidebar Toggle Button (Always visible on mobile, visible on desktop to expand) #}
                <button onclick="toggleSidebar()" class="flex p-3 text-indigo-400 bg-indigo-500/5 hover:bg-indigo-500/15 hover:text-indigo-300 border border-indigo-500/20 rounded-2xl transition-all group shadow-lg shadow-indigo-500/5">
                    <div class="relative w-8 h-8 flex flex-col items-center justify-center gap-1.5">
                        <span class="w-6 h-0.5 bg-current rounded-full transition-all group-hover:w-7 group-hover:translate-x-0.5"></span>
                        <span class="w-6 h-0.5 bg-current rounded-full transition-all"></span>
                        <span class="w-4 h-0.5 bg-current rounded-full self-start transition-all group-hover:w-7"></span>
                    </div>
                </button>
                
                {# Page Title Block #}
                <h2 class="text-2xl font-black text-white hidden 2xl:block flex-shrink-0 tracking-tight">
                    {% block page_title %}Tableau de Bord{% endblock %}
                </h2>
            </div>

            {# Header Content Partial (Search, User Profile, etc.) #}
            {{ include('dashboard/partials/_header_content.html.twig') }}
        </header>

        {# Main Content Area #}
        <main id="main-content" class="flex-1 h-[calc(100vh-5rem)] overflow-y-auto overflow-x-hidden relative z-0">
            {% block content_wrapper %}
            <div class="p-8 w-full max-w-7xl mx-auto">
                
                {# Flash Messages Partial #}
                {{ include('dashboard/partials/_flash_messages.html.twig') }}

                {# Main Body Block #}
                {% block body %}{% endblock %}
            </div>
            {% endblock %}
        </main>
    </div>

    {# Overlay Mobile #}
    {# Overlay Mobile #}
    <div id="mobile-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[45] hidden opacity-0 transition-opacity duration-300"></div>

</body>
</html>
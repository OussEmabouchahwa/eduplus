<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EduPulse | Console{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
    
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
    
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
        <style>
            /* Guarantee sidebar and main layout regardless of Tailwind compiler state */
            body.dashboard-layout {
                display: flex !important;
                flex-direction: row !important;
                width: 100vw;
                height: 100vh;
                overflow: hidden;
            }
            #sidebar {
                width: 16rem; /* 256px */
                flex-shrink: 0;
                position: relative;
                z-index: 40;
                transition: transform 0.3s ease;
                height: 100%;
                overflow-y: auto;
            }
            #main-content {
                flex: 1 1 0%;
                display: flex;
                flex-direction: column;
                height: 100%;
                overflow-y: auto;
                min-width: 0;
            }
            @media (max-width: 768px) {
                #sidebar {
                    position: fixed;
                    top: 0;
                    bottom: 0;
                    left: 0;
                    transform: translateX(-100%);
                }
                #sidebar.open {
                    transform: translateX(0);
                }
            }
        </style>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const btn = document.getElementById('mobile-menu-btn');
                const sidebar = document.getElementById('sidebar');
                if(btn && sidebar) {
                    btn.addEventListener('click', () => {
                        sidebar.classList.toggle('open');
                    });
                }
            });
        </script>
    {% endblock %}
</head>

<body class="dashboard-layout bg-edu-slate text-slate-200 h-screen overflow-hidden flex font-sans antialiased selection:bg-edu-indigo selection:text-white">

    {# --- SIDEBAR (Pro Dashboard) --- #}
    <aside id="sidebar" class="bg-slate-900/95 backdrop-blur-2xl border-r border-white/5 flex flex-col">
        
        {# Logo Area #}
        <div class="h-20 flex items-center justify-between px-6 border-b border-white/5">
            <a href="{{ path('app_home') }}" class="flex items-center gap-3 cursor-pointer group">
                <img src="{{ asset('images/logo.png') }}" alt="EduPulse Logo" class="h-10 w-auto group-hover:scale-105 transition-transform">
                <span class="text-xl font-bold tracking-tight text-white">
                    Edu<span class="text-indigo-400 font-light italic">Pulse</span>
                </span>
            </a>
            {# Bouton de fermeture sur mobile #}
            <button id="mobile-menu-btn" class="md:hidden text-slate-400 hover:text-white">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        {# Navigation Links #}
        <nav class="flex-1 py-6 px-4 space-y-8">
            
            {# Section 1: Principal #}
            <div class="space-y-1.5">
                <div class="text-[10px] font-extrabold text-slate-500 uppercase tracking-widest mb-3 px-3">Principal</div>
                
                <a href="{{ path('app_dashboard') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') starts with 'app_dashboard' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                    <div class="flex items-center gap-3">
                        <div class="p-1.5 rounded-lg {% if app.request.attributes.get('_route') starts with 'app_dashboard' %}bg-indigo-500/20 text-indigo-400{% else %}bg-slate-800 text-slate-400 group-hover:bg-slate-700 group-hover:text-slate-200{% endif %} transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                        </div>
                        Tableau de bord
                    </div>
                </a>

                <a href="{{ path('app_courses') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') starts with 'app_courses' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                    <div class="flex items-center gap-3">
                        <div class="p-1.5 rounded-lg {% if app.request.attributes.get('_route') starts with 'app_courses' %}bg-indigo-500/20 text-indigo-400{% else %}bg-slate-800 text-slate-400 group-hover:bg-slate-700 group-hover:text-slate-200{% endif %} transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                        </div>
                        Catalogue Cours
                    </div>
                </a>

                <a href="{{ path('app_chat') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium transition-all group">
                    <div class="flex items-center gap-3">
                        <div class="p-1.5 rounded-lg bg-slate-800 text-slate-400 group-hover:bg-slate-700 group-hover:text-slate-200 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                        </div>
                        Messages
                    </div>
                    <span class="bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 text-[10px] font-bold px-2 py-0.5 rounded-full">Chat</span>
                </a>

                <a href="{{ path('app_profile') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') == 'app_profile' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                    <div class="flex items-center gap-3">
                        <div class="p-1.5 rounded-lg {% if app.request.attributes.get('_route') == 'app_profile' %}bg-indigo-500/20 text-indigo-400{% else %}bg-slate-800 text-slate-400 group-hover:bg-slate-700 group-hover:text-slate-200{% endif %} transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        </div>
                        Mon Profil
                    </div>
                </a>
            </div>

            {% if is_granted('ROLE_ADMIN') %}
            {# Section 2: Administration #}
            <div class="space-y-1.5">
                <div class="text-[10px] font-extrabold text-slate-500 uppercase tracking-widest mb-3 px-3">Administration</div>
                
                <a href="{{ path('app_admin_user_index') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') starts with 'app_admin_user' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                    <div class="flex items-center gap-3">
                        <div class="p-1.5 rounded-lg {% if app.request.attributes.get('_route') starts with 'app_admin_user' %}bg-indigo-500/20 text-indigo-400{% else %}bg-slate-800 text-slate-400 group-hover:bg-slate-700 group-hover:text-slate-200{% endif %} transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        </div>
                        Utilisateurs
                    </div>
                </a>

                <a href="{{ path('app_admin_teacher_index') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') starts with 'app_admin_teacher' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                    <div class="flex items-center gap-3">
                        <div class="p-1.5 rounded-lg {% if app.request.attributes.get('_route') starts with 'app_admin_teacher' %}bg-indigo-500/20 text-indigo-400{% else %}bg-slate-800 text-slate-400 group-hover:bg-slate-700 group-hover:text-slate-200{% endif %} transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                        </div>
                        Formateurs
                    </div>
                </a>

                <a href="{{ path('app_admin_course_index') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') starts with 'app_admin_course' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                    <div class="flex items-center gap-3">
                        <div class="p-1.5 rounded-lg {% if app.request.attributes.get('_route') starts with 'app_admin_course' %}bg-indigo-500/20 text-indigo-400{% else %}bg-slate-800 text-slate-400 group-hover:bg-slate-700 group-hover:text-slate-200{% endif %} transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                        </div>
                        Cours
                    </div>
                </a>

            </div>
            {% endif %}
            
        </nav>
    </aside>

    {# --- MAIN CONTENT --- #}
    <main id="main-content" class="bg-edu-slate relative z-10">
        
        {# Topbar inside dashboard #}
        <header class="h-20 border-b border-white/5 bg-slate-900/50 backdrop-blur-md sticky top-0 z-30 flex items-center justify-between px-4 md:px-8">
            <div class="flex items-center gap-4">
                {# Menu Burger Mobile #}
                <button onclick="document.getElementById('sidebar').classList.toggle('-translate-x-full')" class="md:hidden p-2 text-slate-400 hover:text-white rounded-lg hover:bg-white/5 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <h2 class="text-lg md:text-xl font-bold text-white hidden sm:block">{% block page_title %}Tableau de Bord{% endblock %}</h2>
            </div>
            
            {# User Profile in Topbar #}
            <div class="flex items-center gap-6">
                {# Notifications #}
                <button class="p-2 text-slate-400 hover:text-white rounded-full hover:bg-white/5 transition-colors relative">
                    <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full border border-slate-900"></span>
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                </button>
                
                {# Profile Menu #}
                <div class="flex items-center gap-3 pl-6 border-l border-white/10">
                    <div class="text-right hidden md:block">
                        <p class="text-sm font-bold text-white leading-tight">{{ app.user.firstName }} {{ app.user.lastName }}</p>
                        <p class="text-xs text-indigo-400 font-medium">{% if is_granted('ROLE_ADMIN') %}Administrateur{% elseif is_granted('ROLE_TEACHER') %}Formateur{% else %}Étudiant{% endif %}</p>
                    </div>
                    
                    <div class="relative group cursor-pointer">
                        <div class="w-10 h-10 rounded-full border-2 border-indigo-500/30 overflow-hidden shadow-lg shadow-indigo-500/10 transition-transform group-hover:scale-105">
                            {% if app.user.profilePhoto %}
                                <img src="{{ asset('uploads/profiles/' ~ app.user.profilePhoto) }}" alt="Profile Photo" class="w-full h-full object-cover">
                            {% else %}
                                <div class="w-full h-full bg-slate-800 flex items-center justify-center text-slate-300 font-bold uppercase text-sm">
                                    {{ app.user.firstName|first }}{{ app.user.lastName|first }}
                                </div>
                            {% endif %}
                        </div>
                        
                        {# Dropdown Menu (Hover) #}
                        <div class="absolute right-0 mt-2 w-48 bg-slate-800 border border-slate-700 rounded-xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top-right">
                            <div class="p-2 space-y-1">
                                <div class="md:hidden px-3 py-2 mb-2 border-b border-slate-700">
                                    <p class="text-sm font-bold text-white truncate">{{ app.user.firstName }} {{ app.user.lastName }}</p>
                                </div>
                                <a href="{{ path('app_profile') }}" class="block px-3 py-2 text-sm text-slate-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors">Mon Profil</a>
                                <a href="{{ path('app_logout') }}" class="block px-3 py-2 text-sm font-semibold text-red-400 hover:text-red-300 hover:bg-red-500/10 rounded-lg transition-colors">Déconnexion</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        {% block content_wrapper %}
        <div class="p-4 md:p-8 max-w-7xl mx-auto flex-1 flex flex-col min-h-[calc(100vh-5rem)]">
            {# Flash Messages #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="glass-card mb-6 p-4 border-l-4 {% if label == 'success' %}border-emerald-500 bg-emerald-500/10 text-emerald-100{% else %}border-red-500 bg-red-500/10 text-red-100{% endif %} rounded-r-xl">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {# Content Block #}
            {% block body %}{% endblock %}
        </div>
        {% endblock %}
    </main>

    {# Overlay Mobile #}
    <div id="mobile-overlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-30 hidden md:hidden transition-opacity" onclick="document.getElementById('sidebar').classList.remove('open');"></div>

</body>
</html>

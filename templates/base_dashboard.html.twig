<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EduPulse | Console{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
    
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
    
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
        {{ include('dashboard/partials/_head_assets.html.twig') }}
    {% endblock %}
</head>

<body class="dashboard-layout {% block body_class %}bg-slate-50 dark:bg-[#020617] text-slate-900 dark:text-slate-200{% endblock %} font-sans antialiased selection:bg-indigo-500 selection:text-white transition-colors duration-300">

    {# Sidebar Area #}
    <aside id="sidebar" class="fixed left-0 top-0 bottom-0 z-[110] bg-white dark:bg-slate-900/95 backdrop-blur-2xl border-r border-slate-200 dark:border-white/5 shadow-2xl transition-all duration-300 md:translate-x-0 -translate-x-full overflow-hidden flex flex-col">
        {{ include('dashboard/partials/_sidebar.html.twig') }}
    </aside>

    {# Main Content Wrapper #}
    <div id="main-wrapper" class="bg-slate-50 dark:bg-edu-slate relative z-10 w-full flex flex-col min-w-0">
        
        {# Header Area #}
        <header class="h-20 border-b border-slate-200 dark:border-white/5 bg-white/80 dark:bg-slate-950/80 backdrop-blur-2xl flex items-center justify-start px-8 md:px-12 relative z-[100] flex-shrink-0 shadow-sm gap-8 transition-colors">
             <div class="flex items-center gap-6">
                {# Mobile Menu Button #}
                <button onclick="toggleSidebar()" class="md:hidden p-4 text-slate-400 hover:text-indigo-500 rounded-2xl hover:bg-slate-100 dark:hover:bg-white/10 transition-all">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <h2 class="text-2xl font-black text-slate-800 dark:text-white hidden 2xl:block flex-shrink-0 tracking-tight transition-colors">
                    {% block page_title %}Tableau de Bord{% endblock %}
                </h2>
            </div>

            {# Header Content Partial #}
            {{ include('dashboard/partials/_header_content.html.twig') }}
        </header>

        {# Main Content Area #}
        <main id="main-content" class="flex-1 overflow-y-auto p-8 md:p-12 relative">
            {# Flash Messages #}
            {{ include('dashboard/partials/_flash_messages.html.twig') }}
            
            {% block content_wrapper %}
                {% block body %}{% endblock %}
            {% endblock %}
        </main>
    </div>

    {# Overlay Mobile #}
    <div id="mobile-overlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-30 hidden md:hidden transition-opacity" onclick="document.getElementById('sidebar').classList.remove('open');"></div>

</body>
</html>
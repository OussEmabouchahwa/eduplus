<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EduPulse | Console{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
    
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
    
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
        <style>
            /* Guarantee sidebar and main layout regardless of Tailwind compiler state */
            body.dashboard-layout {
                display: flex !important;
                flex-direction: row !important;
                width: 100vw;
                height: 100vh;
                overflow: hidden;
            }
            #sidebar {
                width: 16rem;
                flex-shrink: 0;
                position: relative;
                z-index: 40;
                transition: transform 0.3s ease;
                height: 100%;
            }
            /* FIX: Separated header from scrolling content - no overflow conflicts */
            #main-wrapper {
                flex: 1 1 0%;
                display: flex;
                flex-direction: column;
                height: 100%;
                min-width: 0;
            }
            #main-content {
                flex: 1;
                overflow-y: auto;
            }
            @media (max-width: 768px) {
                #sidebar {
                    position: fixed;
                    top: 0;
                    bottom: 0;
                    left: 0;
                    transform: translateX(-100%);
                }
                #sidebar.open {
                    transform: translateX(0);
                }
            }
        </style>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const btn = document.getElementById('mobile-menu-btn');
                const sidebar = document.getElementById('sidebar');
                if(btn && sidebar) {
                    btn.addEventListener('click', () => {
                        sidebar.classList.toggle('open');
                    });
                }
            });
        </script>
    {% endblock %}
</head>

<body class="dashboard-layout bg-edu-slate text-slate-200 h-screen overflow-hidden flex font-sans antialiased selection:bg-edu-indigo selection:text-white">

    {# --- SIDEBAR (Pro Dashboard) --- #}
    <aside id="sidebar" class="bg-slate-900/95 backdrop-blur-xl w-64 flex-shrink-0 border-r border-slate-800 flex flex-col transition-transform duration-300 md:relative md:translate-x-0 absolute inset-y-0 left-0 z-40 transform -translate-x-full">
        
        {# Logo Area — same height as topbar, no bottom border to avoid double-line with navbar #}
        <div class="h-20 flex items-center justify-between px-6">
            <a href="{{ path('app_home') }}" class="flex items-center gap-3 cursor-pointer group">
                <img src="{{ asset('images/logo.png') }}" alt="EduPulse Logo" class="h-10 w-auto group-hover:scale-105 transition-transform">
                <span class="text-xl font-bold tracking-tight text-white">
                    Edu<span class="text-indigo-400 font-light italic">Pulse</span>
                </span>
            </a>
            {# Bouton de fermeture sur mobile #}
            <button id="mobile-menu-btn" class="md:hidden text-slate-400 hover:text-white">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        {# Navigation Links #}
        <nav class="flex-1 py-6 px-4 space-y-8">
            
            {# Section 1: Principal #}
            <div class="space-y-1.5">
                <div class="text-[10px] font-extrabold text-slate-500 uppercase tracking-widest mb-3 px-3">Principal</div>
                
                <a href="{{ path('app_dashboard') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') starts with 'app_dashboard' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                    <div class="flex items-center gap-4">
                        <div class="flex-shrink-0 flex items-center justify-center transition-transform group-hover:scale-110 group-hover:-translate-y-0.5 duration-300">
                            <img src="{{ asset('icons/Minimalist_house_icon.png') }}" alt="Dashboard" class="w-5 h-5 object-contain drop-shadow-[0_0_8px_rgba(99,102,241,0.3)]">
                        </div>
                        <span class="text-[15px]">Tableau de bord</span>
                    </div>
                </a>

                <a href="{{ path('app_courses') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') starts with 'app_courses' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                    <div class="flex items-center gap-4">
                        <div class="flex-shrink-0 flex items-center justify-center transition-transform group-hover:scale-110 group-hover:-translate-y-0.5 duration-300">
                            <img src="{{ asset('icons/coursecatloge-.png') }}" alt="Catalogue" class="w-5 h-5 object-contain">
                        </div>
                        <span class="text-[15px]">Catalogue Cours</span>
                    </div>
                </a>

                <a href="{{ path('app_chat') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium transition-all group">
                    <div class="flex items-center gap-4">
                        <div class="flex-shrink-0 flex items-center justify-center transition-transform group-hover:scale-110 group-hover:-translate-y-0.5 duration-300">
                            <img src="{{ asset('icons/messagesSection.png') }}" alt="Messages" class="w-5 h-5 object-contain">
                        </div>
                        <span class="text-[15px]">Messages</span>
                    </div>
                    <span class="bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 text-[10px] font-bold px-2 py-0.5 rounded-full">Chat</span>
                </a>

                <a href="{{ path('app_profile') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') == 'app_profile' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                    <div class="flex items-center gap-4">
                        <div class="flex-shrink-0 flex items-center justify-center transition-transform group-hover:scale-110 group-hover:-translate-y-0.5 duration-300">
                            <img src="{{ asset('icons/authntification.png') }}" alt="Profil" class="w-5 h-5 object-contain">
                        </div>
                        <span class="text-[15px]">Mon Profil</span>
                    </div>
                </a>
            </div>

            {% if is_granted('ROLE_ADMIN') %}
            {# Section 2: Administration #}
            <div class="space-y-1.5">
                <div class="text-[10px] font-extrabold text-slate-500 uppercase tracking-widest mb-3 px-3">Administration</div>
                
                <a href="{{ path('app_admin_user_index') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') starts with 'app_admin_user' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                    <div class="flex items-center gap-4">
                        <div class="flex-shrink-0 flex items-center justify-center transition-transform group-hover:scale-110 group-hover:-translate-y-0.5 duration-300">
                            <img src="{{ asset('icons/Group_of_users_icon.png') }}" alt="Utilisateurs" class="w-5 h-5 object-contain">
                        </div>
                        <span class="text-[15px]">Utilisateurs</span>
                    </div>
                </a>

                <a href="{{ path('app_admin_teacher_index') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') starts with 'app_admin_teacher' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                    <div class="flex items-center gap-4">
                        <div class="flex-shrink-0 flex items-center justify-center transition-transform group-hover:scale-110 group-hover:-translate-y-0.5 duration-300">
                            <img src="{{ asset('icons/teatcherr.png') }}" alt="Formateurs" class="w-5 h-5 object-contain">
                        </div>
                        <span class="text-[15px]">Formateurs</span>
                    </div>
                </a>

                <a href="{{ path('app_admin_course_index') }}" class="flex items-center justify-between px-3 py-2.5 rounded-xl {% if app.request.attributes.get('_route') starts with 'app_admin_course' %}bg-indigo-500/10 text-indigo-400 font-bold shadow-[inset_4px_0_0_0_rgba(99,102,241,1)]{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all group">
                    <div class="flex items-center gap-4">
                        <div class="flex-shrink-0 flex items-center justify-center transition-transform group-hover:scale-110 group-hover:-translate-y-0.5 duration-300">
                            <img src="{{ asset('icons/Library_and_Books_icon.png') }}" alt="Cours" class="w-5 h-5 object-contain">
                        </div>
                        <span class="text-[15px]">Cours</span>
                    </div>
                </a>

            </div>
            {% endif %}
            
        </nav>
    </aside>

    {# --- MAIN WRAPPER --- #}
    <div id="main-wrapper" class="bg-edu-slate relative z-10 w-full">
        {# FIX: h-20 matches sidebar perfectly. Single border-b here, no duplication from sidebar #}
        <header class="h-20 border-b border-slate-800 bg-slate-900/90 backdrop-blur-2xl flex items-center justify-between px-8 md:px-12 z-[100] flex-shrink-0">
            <div class="flex items-center gap-6">
                {# Menu Burger Mobile #}
                <button onclick="document.getElementById('sidebar').classList.toggle('-translate-x-full')" class="md:hidden p-4 text-slate-400 hover:text-white rounded-2xl hover:bg-white/10 transition-all">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <h2 class="text-2xl font-black text-white hidden 2xl:block flex-shrink-0 tracking-tight">{% block page_title %}Tableau de Bord{% endblock %}</h2>
            </div>
            
            {# Central Search Bar - Expanded #}
            <div class="flex-1 max-w-2xl px-12">
                <div class="w-full relative group">
                    <div class="absolute inset-y-0 left-0 pl-6 flex items-center pointer-events-none">
                        <img src="{{ asset('icons/Search.png') }}" alt="Search" class="w-6 h-6 object-contain opacity-50 group-focus-within:opacity-100 transition-opacity">
                    </div>
                    <input type="text" 
                           placeholder="Rechercher des cours, des étudiants, des formateurs..." 
                           class="block w-full bg-slate-950/40 border border-slate-700/50 rounded-2xl py-3 pl-14 pr-6 text-base text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500/50 focus:bg-slate-900 transition-all shadow-inner backdrop-blur-md">
                </div>
            </div>
            
            {# User Profile in Topbar #}
            <div class="flex items-center gap-8">
                {% if app.user %}
                    {# Notifications #}
                <button class="p-2 text-slate-400 hover:text-white rounded-2xl hover:bg-white/5 transition-all group">
                    <div class="relative w-10 h-10 flex items-center justify-center group-hover:scale-110 transition-transform">
                        <span class="absolute top-0 right-0 w-3 h-3 bg-red-500 rounded-full border-2 border-slate-900 z-10 animate-pulse"></span>
                        <img src="{{ asset('icons/Notification.png') }}" alt="Notifications" class="w-8 h-8 object-contain">
                    </div>
                </button>
                    
                {# Profile Menu #}
                <div class="flex items-center gap-4 pl-8 border-l border-white/10">
                    <div class="text-right hidden md:block">
                        <p class="text-base font-bold text-white leading-tight">{{ app.user.firstName }} {{ app.user.lastName }}</p>
                        <p class="text-sm text-indigo-400 font-medium">{% if is_granted('ROLE_ADMIN') %}Administrateur{% elseif is_granted('ROLE_TEACHER') %}Formateur{% else %}Étudiant{% endif %}</p>
                    </div>
                    
                    <div class="relative group">
                        <div class="flex items-center gap-4 cursor-pointer py-2">
                            <div class="w-14 h-14 rounded-full border-2 border-indigo-500/30 overflow-hidden shadow-2xl shadow-indigo-500/10 transition-transform group-hover:scale-105">
                                {% if app.user.profilePhoto %}
                                    <img src="{{ asset('uploads/profiles/' ~ app.user.profilePhoto) }}" alt="Profile Photo" class="w-full h-full object-cover">
                                {% else %}
                                    <div class="w-full h-full bg-slate-800 flex items-center justify-center text-slate-300 font-bold uppercase text-lg">
                                        {{ app.user.firstName|first }}{{ app.user.lastName|first }}
                                    </div>
                                {% endif %}
                            </div>
                            <svg class="w-5 h-5 text-slate-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </div>
                        
                        {# Dropdown Menu #}
                        <div class="absolute right-0 top-full w-72 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 translate-y-4 group-hover:translate-y-2 z-[200]">
                            <div class="mt-2 bg-slate-900/95 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl overflow-hidden p-2">
                                <div class="px-5 py-4 border-b border-white/5 mb-2 bg-white/5 rounded-xl">
                                    <p class="text-[15px] font-bold text-white truncate">{{ app.user.firstName }} {{ app.user.lastName }}</p>
                                    <p class="text-xs text-indigo-400 font-black uppercase tracking-wider mt-1">
                                        {% if is_granted('ROLE_ADMIN') %}Administrateur{% elseif is_granted('ROLE_TEACHER') %}Formateur{% else %}Étudiant{% endif %}
                                    </p>
                                </div>
                                <div class="p-2">
                                        <a href="{{ path('app_profile') }}" class="flex items-center gap-3 px-3 py-2.5 text-sm text-slate-300 hover:text-white hover:bg-white/5 rounded-xl transition-all group/item">
                                            <div class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center group-hover/item:bg-indigo-500/20 transition-colors">
                                                <img src="{{ asset('icons/Settingsicon.png') }}" alt="Settings" class="w-4 h-4 object-contain">
                                            </div>
                                            <span>Mon Profil</span>
                                        </a>
                                        <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-3 py-2.5 text-sm font-semibold text-red-400 hover:text-red-300 hover:bg-red-500/10 rounded-xl transition-all group/item">
                                            <div class="w-8 h-8 rounded-lg bg-red-500/10 flex items-center justify-center group-hover/item:bg-red-500/20 transition-colors">
                                                <img src="{{ asset('icons/Logout_icon_exit.png') }}" alt="Logout" class="w-4 h-4 object-contain">
                                            </div>
                                            <span>Déconnexion</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="flex items-center gap-3">
                        <a href="{{ path('app_login') }}" class="text-slate-400 hover:text-white font-bold text-sm transition-colors">Connexion</a>
                        <a href="{{ path('app_register') }}" class="bg-indigo-500 hover:bg-indigo-400 text-white px-5 py-2.5 rounded-xl font-black text-sm transition-all shadow-lg shadow-indigo-500/20">S'inscrire</a>
                    </div>
                {% endif %}
            </div>

        </header>

        {# Scrollable Content Area #}
        <main id="main-content">
            {% block content_wrapper %}
            <div class="p-8 w-full max-w-7xl mx-auto">
                {# Flash Messages #}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="mb-6 p-4 border-l-4 {% if label == 'success' %}border-emerald-500 bg-emerald-500/10 text-emerald-100{% else %}border-red-500 bg-red-500/10 text-red-100{% endif %} rounded-r-xl">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {# Content Block #}
                {% block body %}{% endblock %}
            </div>
            {% endblock %}
        </main>

    </div>

    {# Overlay Mobile #}
    <div id="mobile-overlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-30 hidden md:hidden transition-opacity" onclick="document.getElementById('sidebar').classList.remove('open');"></div>

</body>
</html>
<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EduPulse | Console{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
    
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
    
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>

<body class="bg-edu-slate text-slate-200 h-screen overflow-hidden flex font-sans antialiased selection:bg-edu-indigo selection:text-white">

    {# --- SIDEBAR (Pro Dashboard) --- #}
    <aside class="w-64 flex-shrink-0 bg-slate-900/50 backdrop-blur-2xl border-r border-white/5 flex flex-col transition-all duration-300 relative z-20">
        
        {# Logo Area #}
        <div class="h-20 flex items-center px-6 border-b border-white/5">
            <a href="{{ path('app_home') }}" class="flex items-center gap-3 cursor-pointer group">
                <img src="{{ asset('images/logo.png') }}" alt="EduPulse Logo" class="h-10 w-auto group-hover:scale-105 transition-transform">
                <span class="text-xl font-bold tracking-tight text-white">
                    Edu<span class="text-indigo-400 font-light italic">Pulse</span>
                </span>
            </a>
        </div>

        {# Navigation Links #}
        <nav class="flex-1 overflow-y-auto py-6 px-4 space-y-2">
            
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-4 px-2">Menu Principal</div>
            
            <a href="{{ path('app_dashboard') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl {% if app.request.attributes.get('_route') starts with 'app_dashboard' %}bg-indigo-500/10 text-indigo-400 font-bold border border-indigo-500/20{% else %}text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium{% endif %} transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                Tableau de bord
            </a>

            {% if is_granted('ROLE_ADMIN') %}
                <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium transition-all">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    Utilisateurs
                </a>
            {% endif %}

            <a href="{{ path('app_courses') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:bg-white/5 hover:text-slate-200 font-medium transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                Catalogue Cours
            </a>
            
        </nav>

        {# User Profile & Logout #}
        <div class="p-4 border-t border-white/5">
            <div class="glass-card p-4 flex flex-col gap-3 rounded-xl border border-white/5 bg-black/20">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-indigo-500/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400 font-bold uppercase">
                        {{ app.user.firstName|first }}{{ app.user.lastName|first }}
                    </div>
                    <div class="overflow-hidden">
                        <p class="text-sm font-bold text-white truncate">{{ app.user.firstName }} {{ app.user.lastName }}</p>
                        <p class="text-xs text-slate-400 truncate">{{ app.user.email }}</p>
                    </div>
                </div>
                <a href="{{ path('app_logout') }}" class="w-full flex items-center justify-center gap-2 py-2 rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 hover:text-red-300 transition-colors text-sm font-semibold">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                    Déconnexion
                </a>
            </div>
        </div>
    </aside>

    {# --- MAIN CONTENT --- #}
    <main class="flex-1 overflow-y-auto relative z-10">
        
        {# Optional Topbar inside dashboard (just for mobile menu or breadcrumbs) #}
        <header class="h-20 border-b border-white/5 bg-slate-900/30 backdrop-blur-md sticky top-0 z-10 flex items-center justify-between px-8">
            <h2 class="text-xl font-bold text-white">{% block page_title %}Tableau de Bord{% endblock %}</h2>
            <div class="flex items-center gap-4">
                {# Notifications or other tools can go here #}
                <button class="p-2 rounded-full hover:bg-white/5 text-slate-400 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                </button>
            </div>
        </header>

        <div class="p-8 max-w-7xl mx-auto">
            {# Flash Messages #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="glass-card mb-6 p-4 border-l-4 {% if label == 'success' %}border-green-500{% else %}border-red-500{% endif %}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {# Content Block #}
            {% block body %}{% endblock %}
        </div>
    </main>

</body>
</html>

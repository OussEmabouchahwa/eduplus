{% extends 'base.html.twig' %}
{% block body_class %}bg-[#020617] text-slate-200 font-sans antialiased selection:bg-edu-indigo selection:text-white{% endblock %}
{% block sidebar %}{% endblock %}
{% block navbar_content %}{% endblock %}
{% block navbar_brand %}
    <a href="{{ path('app_home') }}" class="flex items-center gap-4 mr-8 group">
        <div class="w-12 h-12 bg-white/5 rounded-2xl flex items-center justify-center group-hover:scale-105 transition-transform shadow-lg">
            <img src="{{ asset('images/logo.png') }}" alt="EduPulse Logo" class="w-8 h-8 object-contain">
        </div>
        <span class="text-2xl font-bold tracking-tight text-white">
            Edu<span class="text-indigo-400 font-light italic">Pulse</span>
        </span>
    </a>
{% endblock %}

{% block title %}{{ course.title }} | EduPulse{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-12 max-w-6xl">
    
    {# Fil d'Ariane #}
    <nav class="flex mb-8 text-sm font-medium text-slate-500" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li><a href="{{ path('app_courses') }}" class="hover:text-indigo-400 transition-colors">Cours</a></li>
            <li>
                <div class="flex items-center">
                    <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                    </svg>
                    <span class="ml-1 text-slate-300">{{ course.title }}</span>
                </div>
            </li>
        </ol>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        {# Contenu principal (Gauche) #}
        <div class="lg:col-span-2 space-y-10">
            {# Header du cours #}
            <div class="space-y-6">
                <h1 class="text-4xl md:text-5xl font-black text-white leading-tight">
                    {{ course.title }}
                </h1>
                <div class="flex flex-wrap items-center gap-6 text-sm">
                    <div class="flex items-center gap-2 text-slate-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        Par <span class="text-white font-bold">{{ course.teacher.firstName }} {{ course.teacher.lastName }}</span>
                    </div>
                    <div class="flex items-center gap-2 text-slate-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Dernière mise à jour : Mai 2026
                    </div>
                </div>
            </div>

            {# Image principale #}
            <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-700/50 h-[400px]">
                <img src="{{ asset('images/' ~ course.imagePath) }}" alt="{{ course.title }}" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent opacity-40"></div>
            </div>

            {# Contenu pédagogique #}
            <div class="glass-card p-10 prose prose-invert max-w-none">
                <h2 class="text-2xl font-bold text-white mb-6 border-b border-slate-700/50 pb-4">À propos de ce cours</h2>
                <div class="text-slate-300 leading-relaxed space-y-4">
                    {{ course.content|raw }}
                </div>
            </div>
        </div>

        {# Sidebar (Droite) #}
        <div class="space-y-8">
            <div class="sticky top-28 space-y-6">
                {# Card d'action #}
                <div class="glass-card border-indigo-500/30 rounded-3xl p-8 shadow-[0_0_40px_rgba(99,102,241,0.15)]">
                    <div class="text-3xl font-black text-white mb-6">Gratuit</div>
                    
                    <ul class="space-y-4 mb-8">
                        <li class="flex items-center gap-3 text-sm text-slate-300">
                            <svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            Accès à vie au contenu
                        </li>
                        <li class="flex items-center gap-3 text-sm text-slate-300">
                            <svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            Salon de discussion dédié
                        </li>
                        <li class="flex items-center gap-3 text-sm text-slate-300">
                            <svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            Support du professeur
                        </li>
                    </ul>

                    {# Lien vers le salon de discussion (Groupe du cours) #}
                    <a href="{{ path('app_chat_room', {courseId: course.id}) }}" 
                       class="w-full py-4 bg-indigo-600 hover:bg-indigo-500 text-white font-black rounded-2xl transition-all shadow-lg shadow-indigo-600/30 flex items-center justify-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
                        </svg>
                        Rejoindre le salon
                    </a>
                </div>

                {# Infos supplémentaires #}
                <div class="bg-slate-900/40 border border-slate-700/50 rounded-2xl p-6">
                    <h4 class="text-sm font-bold text-white mb-4 uppercase tracking-widest">Partager</h4>
                    <div class="flex gap-4">
                        <button class="h-10 w-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-slate-700 transition-colors">
                            <i class="fab fa-facebook text-slate-300"></i>
                        </button>
                        <button class="h-10 w-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-slate-700 transition-colors">
                            <i class="fab fa-twitter text-slate-300"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

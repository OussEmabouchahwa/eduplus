{# Courses Grid Section #}
<section id="courses" class="py-56 relative overflow-hidden bg-[#020617]">
    {# Décoration de fond massif #}
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-indigo-600/10 rounded-full blur-[150px] pointer-events-none"></div>
    
    <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-20">
            <h2 class="text-4xl lg:text-6xl font-black text-white mb-8 tracking-tight">Nos <span class="text-gradient italic">Formations</span></h2>
            <p class="text-xl text-slate-400 max-w-2xl mx-auto font-light leading-relaxed">Explorez nos programmes intensifs et rejoignez la communauté EduPulse.</p>
            </br>
            </br>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            {% for course in courses %}
                <div class="glass-card rounded-[2.5rem] overflow-hidden group transition-all duration-500 hover:-translate-y-2 border-white/5 hover:border-indigo-500/30 flex flex-col shadow-2xl">
                    {# Course Image Wrapper #}
                    <div class="relative h-64 overflow-hidden">
                        {% set imgSrc = course.imagePath ? (course.imagePath starts with 'courses/' ? asset('images/' ~ course.imagePath) : asset('uploads/courses/' ~ course.imagePath)) : asset('images/landingpage/Learning Space.png') %}
                        <img src="{{ imgSrc }}" alt="{{ course.title }}" class="w-full h-full object-cover transform transition-transform duration-1000 group-hover:scale-110">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-60"></div>
                        
                        {# Category Badge #}
                        <div class="absolute top-6 left-6 px-4 py-1.5 rounded-full bg-indigo-500/20 backdrop-blur-md border border-indigo-500/30 text-indigo-300 text-[10px] font-black uppercase tracking-widest">
                            Formation Pro
                        </div>
                    </div>

                    {# Course Content #}
                    <div class="p-8 flex flex-col flex-1">
                        <h3 class="text-2xl font-bold text-white mb-4 group-hover:text-indigo-400 transition-colors">{{ course.title }}</h3>
                        <p class="text-slate-400 text-sm font-light leading-relaxed mb-8 flex-1">
                            {{ course.description|length > 120 ? course.description|slice(0, 120) ~ '...' : course.description }}
                        </p>
                        
                        <div class="flex items-center justify-between pt-6 border-t border-white/5 mt-auto">
                            <div class="flex items-center gap-2">
                                <div class="w-8 h-8 rounded-full bg-slate-800 border border-white/10 flex items-center justify-center text-[10px] text-slate-400 font-bold">
                                    EP
                                </div>
                                <span class="text-xs text-slate-500 font-medium italic">Par EduPulse</span>
                            </div>

                            {% if app.user %}
                                {% if app.user.enrolledCourses.contains(course) %}
                                    <a href="{{ path('app_dashboard_student') }}" class="px-6 py-3 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-black uppercase tracking-widest transition-all hover:bg-emerald-500 hover:text-white">
                                        Accéder
                                    </a>
                                {% else %}
                                    <form action="{{ path('app_course_enroll', {'id': course.id}) }}" method="POST">
                                        <button type="submit" class="px-6 py-3 rounded-xl bg-indigo-500 hover:bg-indigo-400 text-white shadow-lg shadow-indigo-500/20 text-xs font-black uppercase tracking-widest transition-all">
                                            Rejoindre
                                        </button>
                                    </form>
                                {% endif %}
                            {% else %}
                                <a href="{{ path('app_register') }}" class="px-6 py-3 rounded-xl bg-white/5 hover:bg-white/10 text-white border border-white/10 text-xs font-black uppercase tracking-widest transition-all">
                                    S'inscrire
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
</br>
</br>


{% extends 'base.html.twig' %}

{% block title %}EduPulse | Apprentissage Hybride & Temps Réel{% endblock %}

{% block body %}

{# =========================================================================
   1. HERO SECTION
   ========================================================================= #}
<section class="relative pt-24 pb-32 lg:pt-36 lg:pb-40 overflow-hidden bg-[#0B1120]">
    {# Éléments de décoration (Néon flouté) #}
    <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-indigo-600/20 rounded-full mix-blend-screen filter blur-[120px] opacity-60 animate-pulse pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-cyan-600/10 rounded-full mix-blend-screen filter blur-[120px] opacity-60 pointer-events-none"></div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            
            {# Colonne Gauche : Texte #}
            <div class="space-y-10">
                <div class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full glass-card border-indigo-500/30 text-indigo-300 text-xs font-bold tracking-[0.2em] uppercase shadow-[0_0_15px_rgba(99,102,241,0.15)]">
                    <span class="relative flex h-3 w-3">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-3 w-3 bg-indigo-500"></span>
                    </span>
                    La nouvelle ère du LMS
                </div>
                
                <h1 class="text-5xl lg:text-7xl font-black text-white leading-[1.15] tracking-tight">
                    Apprenez, Codez et <br/>
                    <span class="text-gradient">Échangez en Direct.</span>
                </h1>
                
                <p class="text-lg lg:text-xl text-slate-400 leading-relaxed max-w-xl font-light">
                    EduPulse redéfinit la formation technologique. Profitez de cours premium et de salons de discussion en temps réel propulsés par <strong class="text-slate-200">Mercure</strong>. Accélérez votre carrière dès aujourd'hui.
                </p>
                
                <div class="flex flex-col sm:flex-row gap-5 pt-4">
                    <a href="{{ path('app_register') }}" class="bg-gradient-to-r from-indigo-500 to-cyan-500 hover:from-indigo-400 hover:to-cyan-400 text-white rounded-xl text-center font-bold py-4 px-8 text-lg flex items-center justify-center gap-3 transition-all duration-300 shadow-[0_0_20px_rgba(99,102,241,0.3)] hover:shadow-[0_0_30px_rgba(34,211,238,0.5)] hover:-translate-y-1">
                        Commencer gratuitement
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                    </a>
                    <a href="{{ path('app_courses') }}" class="glass-card text-slate-300 text-center font-semibold py-4 px-8 hover:bg-white/10 hover:text-white rounded-xl flex items-center justify-center gap-3 transition-all duration-300">
                        Découvrir le programme
                    </a>
                </div>
            </div>

            {# Colonne Droite : Visuel Hero (Utilisation de monitor+student.png) #}
            <div class="relative group perspective-1000 hidden lg:block">
                <div class="absolute -inset-2 bg-gradient-to-r from-indigo-500 to-cyan-500 rounded-2xl blur-xl opacity-20 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"></div>
                <div class="relative rounded-2xl overflow-hidden glass-card border-white/10 transform transition-all duration-700 hover:rotate-y-6 hover:scale-[1.03] shadow-2xl">
                    <img src="{{ asset('images/landingpage/monitor+student.png') }}" alt="Hologramme éducatif EduPulse" class="w-full object-cover">
                </div>
            </div>
            
        </div>
    </div>
</section>

{# =========================================================================
   2. FEATURES SECTION (La proposition de valeur)
   ========================================================================= #}
<section class="py-32 relative border-t border-white/5 bg-[#080D1A]">
    <div class="container mx-auto px-6 relative z-10">
        
        <div class="text-center mb-24">
            <h2 class="text-4xl lg:text-5xl font-black text-white mb-6 tracking-tight">Un écosystème conçu pour <span class="text-gradient">l'excellence</span></h2>
            <p class="text-slate-400 text-lg max-w-2xl mx-auto font-light">Oubliez les plateformes statiques. Vivez une expérience d'apprentissage dynamique, fluide et hautement interactive.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
            
            {# Carte 1 : UX & Navigation #}
            <div class="glass-card rounded-2xl p-8 group transition-all duration-500 hover:-translate-y-3 hover:shadow-[0_10px_40px_-10px_rgba(99,102,241,0.3)] hover:border-indigo-500/50 flex flex-col">
                <div class="relative h-56 rounded-xl overflow-hidden mb-8 border border-white/10 bg-slate-900">
                    <div class="absolute inset-0 bg-gradient-to-t from-[#080D1A] to-transparent z-10 opacity-80 group-hover:opacity-40 transition-opacity duration-500"></div>
                    <img src="{{ asset('images/landingpage/UX Sticky & Fluid Navigation (Expérience utilisateur).png') }}" alt="Navigation Fluide" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700">
                    <div class="absolute bottom-4 left-4 z-20 h-14 w-14 rounded-xl bg-indigo-500/20 backdrop-blur-md border border-indigo-400/30 flex items-center justify-center text-indigo-400 shadow-lg">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                    </div>
                </div>
                <h3 class="text-2xl font-bold text-white mb-4 group-hover:text-indigo-400 transition-colors">Expérience Fluide</h3>
                <p class="text-slate-400 text-base leading-relaxed flex-grow font-light">Une interface utilisateur repensée avec une navigation "sticky" pour que vos outils restent toujours à portée de clic.</p>
            </div>

            {# Carte 2 : Temps Réel (Mercure) #}
            <div class="glass-card rounded-2xl p-8 group transition-all duration-500 hover:-translate-y-3 hover:shadow-[0_10px_40px_-10px_rgba(34,211,238,0.3)] hover:border-cyan-500/50 flex flex-col">
                <div class="relative h-56 rounded-xl overflow-hidden mb-8 border border-white/10 bg-slate-900">
                    <div class="absolute inset-0 bg-gradient-to-t from-[#080D1A] to-transparent z-10 opacity-80 group-hover:opacity-40 transition-opacity duration-500"></div>
                    <img src="{{ asset('images/landingpage/Focus Chat Temps Rée right.jpeg') }}" alt="Real-time Chat" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700">
                    <div class="absolute bottom-4 left-4 z-20 h-14 w-14 rounded-xl bg-cyan-500/20 backdrop-blur-md border border-cyan-400/30 flex items-center justify-center text-cyan-400 shadow-lg">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path></svg>
                    </div>
                </div>
                <h3 class="text-2xl font-bold text-white mb-4 group-hover:text-cyan-400 transition-colors">Chat Temps Réel</h3>
                <p class="text-slate-400 text-base leading-relaxed flex-grow font-light">Propulsé par Symfony Mercure. Échangez en direct avec vos pairs et professeurs sans jamais recharger la page.</p>
            </div>

            {# Carte 3 : Digicard & Communauté #}
            <div class="glass-card rounded-2xl p-8 group transition-all duration-500 hover:-translate-y-3 hover:shadow-[0_10px_40px_-10px_rgba(168,85,247,0.3)] hover:border-purple-500/50 flex flex-col">
                <div class="relative h-56 rounded-xl overflow-hidden mb-8 border border-white/10 bg-slate-900">
                    <div class="absolute inset-0 bg-gradient-to-t from-[#080D1A] to-transparent z-10 opacity-80 group-hover:opacity-40 transition-opacity duration-500"></div>
                    <img src="{{ asset('images/landingpage/digicarde.jpeg') }}" alt="Mentoring Connection" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700">
                    <div class="absolute bottom-4 left-4 z-20 h-14 w-14 rounded-xl bg-purple-500/20 backdrop-blur-md border border-purple-400/30 flex items-center justify-center text-purple-400 shadow-lg">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path></svg>
                    </div>
                </div>
                <h3 class="text-2xl font-bold text-white mb-4 group-hover:text-purple-400 transition-colors">Profils & Digicards</h3>
                <p class="text-slate-400 text-base leading-relaxed flex-grow font-light">Mettez en avant vos compétences. Nos cartes numériques vous permettent de briller au sein de la communauté d'apprenants.</p>
            </div>

        </div>
    </div>
</section>

{# =========================================================================
   3. LEARNING SPACE SECTION (Aperçu du produit)
   ========================================================================= #}
<section class="py-32 relative overflow-hidden bg-[#0B1120]">
    {# Décoration de fond massif #}
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-indigo-600/10 rounded-full blur-[150px] pointer-events-none"></div>
    
    <div class="container mx-auto px-6 relative z-10 text-center">
        <h2 class="text-4xl lg:text-6xl font-black text-white mb-8 tracking-tight">Votre nouvel <span class="text-gradient">Espace de Travail</span></h2>
        <p class="text-xl text-slate-400 mb-16 max-w-3xl mx-auto font-light">Une interface scindée pensée pour la productivité absolue. Suivez vos leçons d'un côté, et collaborez avec la communauté de l'autre.</p>
        
        <div class="relative max-w-6xl mx-auto rounded-3xl overflow-hidden glass-card border border-white/10 shadow-[0_0_80px_rgba(99,102,241,0.15)] group">
            <div class="absolute inset-0 bg-gradient-to-t from-[#0B1120] via-transparent to-transparent z-10 opacity-70"></div>
            
            {# Image Officielle Learning Space #}
            <img src="{{ asset('images/landingpage/Learning Space.png') }}" alt="Interface EduPulse Double Écran" class="w-full object-cover transform transition-transform duration-1000 group-hover:scale-[1.02]">
            
            {# Overlay Bouton Play/Join (Décoratif) #}
            <div class="absolute inset-0 z-20 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-slate-900/40 backdrop-blur-sm">
                <a href="{{ path('app_courses') }}" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-full py-4 px-10 text-lg font-bold shadow-[0_0_30px_rgba(99,102,241,0.6)] flex items-center gap-3 transition-transform hover:scale-105">
                    Essayer l'interface
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
            </div>
        </div>
    </div>
</section>

{# =========================================================================
   4. CALL-TO-ACTION SECTION
   ========================================================================= #}
<section class="py-24 relative mb-10 bg-[#080D1A]">
    <div class="container mx-auto px-6 max-w-6xl">
        <div class="relative overflow-hidden rounded-[3rem] p-12 md:p-24 text-center border border-indigo-500/20 shadow-[0_0_50px_rgba(99,102,241,0.1)]">
            
            {# Background Image Vortex/Arbre (Éclosion de Carrière) #}
            <div class="absolute inset-0 z-0 opacity-30 mix-blend-luminosity">
                <img src="{{ asset('images/landingpage/Éclosion de Carrière (Transformation finale).jpeg') }}" alt="Éclosion de Carrière" class="w-full h-full object-cover">
            </div>
            <div class="absolute inset-0 z-0 bg-gradient-to-b from-[#0B1120]/90 via-indigo-950/80 to-[#0B1120]/90"></div>

            <div class="relative z-10">
                <h2 class="text-4xl md:text-6xl font-black text-white mb-8 tracking-tight">Prêt à <span class="text-gradient">pulser</span> votre carrière ?</h2>
                <p class="text-xl text-indigo-100/80 mb-12 max-w-2xl mx-auto font-light leading-relaxed">
                    Rejoignez des milliers de développeurs qui ont déjà transformé leur avenir avec EduPulse. L'inscription est gratuite, l'impact est immédiat.
                </p>
                
                <div class="flex flex-col sm:flex-row gap-6 justify-center">
                    <a href="{{ path('app_register') }}" class="px-10 py-5 bg-white text-indigo-950 hover:bg-slate-100 hover:scale-105 transition-all duration-300 font-black rounded-2xl shadow-[0_0_40px_rgba(255,255,255,0.2)] text-lg flex items-center justify-center gap-3">
                        Créer mon compte
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}
{% extends 'base_dashboard.html.twig' %}
{% block title %}EduPulse | Paramètres du Profil{% endblock %}
{% block page_title %}Mon Profil{% endblock %}

{% block body %}
<div class="animate-fade-in max-w-6xl mx-auto pb-20 px-4">

    {{ form_start(form, {attr: {class: 'space-y-10', enctype: 'multipart/form-data'}}) }}
        
        {# Profile Header Card #}
        <div class="glass-card overflow-hidden relative border border-white/10 shadow-2xl rounded-2xl">
            {# Banner #}
            <div class="h-36 bg-gradient-to-r from-indigo-600 via-indigo-500 to-cyan-500 relative">
                <div class="absolute inset-0 bg-slate-950/20 backdrop-blur-[2px]"></div>
                {# Abstract Glows #}
                <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 blur-[80px] rounded-full translate-x-1/2 -translate-y-1/2"></div>
            </div>

            <div class="px-8 pb-6 relative">
                {# Avatar Upload #}
                <div class="relative -mt-12 mb-4 inline-block group/avatar">
                    <div id="avatar-preview" class="w-24 h-24 rounded-2xl border-[4px] border-slate-950 overflow-hidden bg-slate-900 shadow-2xl relative group cursor-pointer transition-transform duration-500 hover:scale-[1.02]" onclick="document.getElementById('{{ form.profilePhotoFile.vars.id }}').click()">
                        {% if user.profilePhoto %}
                            <img id="avatar-img" src="{{ asset('uploads/profiles/' ~ user.profilePhoto) }}" alt="Avatar" class="w-full h-full object-cover">
                        {% else %}
                            <div id="avatar-placeholder" class="w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-800 to-slate-900 text-slate-500 text-3xl font-black italic">
                                {{ user.firstName|first }}{{ user.lastName|first }}
                            </div>
                        {% endif %}
                        <div class="absolute inset-0 bg-slate-950/60 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 backdrop-blur-sm">
                            <div class="bg-white/10 p-3 rounded-full border border-white/20">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                            </div>
                        </div>
                    </div>
                    
                    {# Explicit Update Button #}
                    <button type="button" onclick="document.getElementById('{{ form.profilePhotoFile.vars.id }}').click()" class="absolute -bottom-1 -right-1 px-3 py-1.5 bg-indigo-500 hover:bg-indigo-400 text-white text-[9px] font-black uppercase tracking-widest rounded-lg border-[3px] border-slate-950 shadow-2xl transition-all hover:scale-105 active:scale-95 flex items-center gap-1.5">
                        <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4"></path></svg>
                        Update
                    </button>

                    <div class="hidden">
                        {{ form_widget(form.profilePhotoFile) }}
                    </div>
                </div>

                <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                    <div>F
                        <h1 class="text-2xl font-black text-white tracking-tight uppercase italic">{{ user.firstName }} {{ user.lastName }}</h1>
                        <div class="flex items-center gap-3 mt-1.5">
                            <span class="px-2.5 py-0.5 rounded-md bg-white/5 border border-white/10 text-slate-400 text-[9px] font-black uppercase tracking-widest italic">
                                {% if is_granted('ROLE_ADMIN') %}Admin
                                {% elseif is_granted('ROLE_TEACHER') %}Teacher
                                {% else %}Student{% endif %}
                            </span>
                            <span class="text-slate-600 font-bold">•</span>
                            <span class="text-slate-400 text-xs font-medium">{{ user.email }}</span>
                        </div>
                    </div>
                    <button type="submit" class="px-6 py-3 bg-indigo-500 hover:bg-indigo-400 text-white rounded-xl text-xs font-black uppercase tracking-widest transition-all shadow-xl shadow-indigo-500/20 active:scale-95">
                        Save Profile
                    </button>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
            {# Left Column: Details #}
            <div class="lg:col-span-2 space-y-10">
                {# Identity Section #}
                <div class="glass-card p-8 rounded-2xl border border-white/5 space-y-8">
                    <div class="flex items-center gap-4 border-b border-white/5 pb-4">
                        <div class="w-10 h-10 bg-indigo-500/10 rounded-xl flex items-center justify-center">
                            <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        </div>
                        <h2 class="text-lg font-bold text-white tracking-wide uppercase italic">Identity</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            {{ form_label(form.firstName, null, {label_attr: {class: 'text-xs font-semibold text-slate-400 ml-1 block'}}) }}
                            {{ form_widget(form.firstName, {attr: {class: 'w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500/50 outline-none transition-all shadow-inner'}}) }}
                        </div>
                        <div class="space-y-2">
                            {{ form_label(form.lastName, null, {label_attr: {class: 'text-xs font-semibold text-slate-400 ml-1 block'}}) }}
                            {{ form_widget(form.lastName, {attr: {class: 'w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500/50 outline-none transition-all shadow-inner'}}) }}
                        </div>
                        <div class="space-y-2 md:col-span-2">
                            {{ form_label(form.phone, null, {label_attr: {class: 'text-xs font-semibold text-slate-400 ml-1 block'}}) }}
                            {{ form_widget(form.phone, {attr: {class: 'w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500/50 outline-none transition-all shadow-inner'}}) }}
                        </div>
                    </div>
                </div>

                {# Professional / Academic Section #}
                {% if is_granted('ROLE_TEACHER') or (is_granted('ROLE_USER') and not is_granted('ROLE_ADMIN')) %}
                    <div class="glass-card p-8 rounded-2xl border border-white/5 space-y-8">
                        <div class="flex items-center gap-4 border-b border-white/5 pb-4">
                            <div class="w-10 h-10 bg-cyan-500/10 rounded-xl flex items-center justify-center">
                                <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                            </div>
                            <h2 class="text-lg font-bold text-white tracking-wide uppercase italic">
                                {% if is_granted('ROLE_TEACHER') %}Professional Experience{% else %}Academic Path{% endif %}
                            </h2>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            {% if is_granted('ROLE_TEACHER') %}
                                <div class="space-y-2">
                                    {{ form_label(form.specialization, null, {label_attr: {class: 'text-xs font-semibold text-slate-400 ml-1 block'}}) }}
                                    {{ form_widget(form.specialization, {attr: {class: 'w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500/50 outline-none transition-all shadow-inner'}}) }}
                                </div>
                                <div class="space-y-2">
                                    {{ form_label(form.experience, null, {label_attr: {class: 'text-xs font-semibold text-slate-400 ml-1 block'}}) }}
                                    {{ form_widget(form.experience, {attr: {class: 'w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500/50 outline-none transition-all shadow-inner'}}) }}
                                </div>
                            {% else %}
                                <div class="space-y-2 md:col-span-2">
                                    {{ form_label(form.major, null, {label_attr: {class: 'text-xs font-semibold text-slate-400 ml-1 block'}}) }}
                                    {{ form_widget(form.major, {attr: {class: 'w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500/50 outline-none transition-all shadow-inner'}}) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                {# Bio Section #}
                <div class="glass-card p-8 rounded-2xl border border-white/5 space-y-8">
                    <div class="flex items-center gap-4 border-b border-white/5 pb-4">
                        <div class="w-10 h-10 bg-purple-500/10 rounded-xl flex items-center justify-center">
                            <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                        </div>
                        <h2 class="text-lg font-bold text-white tracking-wide uppercase italic">Biography</h2>
                    </div>
                    <div class="space-y-2">
                        {{ form_label(form.bio, null, {label_attr: {class: 'text-xs font-semibold text-slate-400 ml-1 block'}}) }}
                        {{ form_widget(form.bio, {attr: {class: 'w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500/50 outline-none transition-all h-32 resize-none shadow-inner'}}) }}
                    </div>
                </div>
            </div>

            {# Right Column: Socials & Alerts #}
            <div class="space-y-10">
                <div class="glass-card p-8 rounded-2xl border border-white/5 space-y-10">
                    <div class="flex items-center gap-4 border-b border-white/5 pb-4">
                        <div class="w-10 h-10 bg-emerald-500/10 rounded-xl flex items-center justify-center">
                            <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                        </div>
                        <h2 class="text-lg font-bold text-white tracking-wide uppercase italic">Links</h2>
                    </div>
                    <div class="space-y-8">
                        <div class="space-y-2">
                            {{ form_label(form.githubUrl, null, {label_attr: {class: 'text-xs font-semibold text-slate-400 ml-1 block'}}) }}
                            <div class="relative group">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <svg class="w-5 h-5 text-slate-500 group-focus-within:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.43.372.823 1.102.823 2.222 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                                </div>
                                {{ form_widget(form.githubUrl, {attr: {class: 'w-full bg-white/5 border border-white/10 rounded-xl pl-12 pr-4 py-3 text-white focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500/50 outline-none transition-all shadow-inner text-sm'}}) }}
                            </div>
                        </div>
                        <div class="space-y-2">
                            {{ form_label(form.linkedinUrl, null, {label_attr: {class: 'text-xs font-semibold text-slate-400 ml-1 block'}}) }}
                            <div class="relative group">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <svg class="w-5 h-5 text-slate-500 group-focus-within:text-blue-400 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                                </div>
                                {{ form_widget(form.linkedinUrl, {attr: {class: 'w-full bg-white/5 border border-white/10 rounded-xl pl-12 pr-4 py-3 text-white focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500/50 outline-none transition-all shadow-inner text-sm'}}) }}
                            </div>
                        </div>
                    </div>
                </div>

                {# Security Hint Card #}
                <div class="glass-card p-6 rounded-2xl bg-amber-500/5 border border-amber-500/20">
                    <div class="flex gap-4">
                        <svg class="w-6 h-6 text-amber-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                        <div>
                            <p class="text-xs font-bold text-amber-500 uppercase tracking-widest mb-1">Sécurité</p>
                            <p class="text-slate-400 text-[11px] leading-relaxed">Assurez-vous que vos informations sont exactes. Votre profil est visible par vos formateurs.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="hidden">
            {{ form_rest(form) }}
        </div>
    {{ form_end(form) }}

    <script>
        // Preview avatar before upload
        document.getElementById('{{ form.profilePhotoFile.vars.id }}').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(ev) {
                const preview = document.getElementById('avatar-preview');
                let img = document.getElementById('avatar-img');
                if (!img) {
                    img = document.createElement('img');
                    img.id = 'avatar-img';
                    img.className = 'w-full h-full object-cover';
                    preview.appendChild(img);
                    const placeholder = document.getElementById('avatar-placeholder');
                    if (placeholder) placeholder.style.display = 'none';
                }
                img.src = ev.target.result;
            };
            reader.readAsDataURL(file);
        });
    </script>
</div>
{% endblock %}
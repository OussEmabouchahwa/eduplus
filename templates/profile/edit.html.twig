{% extends 'base_dashboard.html.twig' %}
{% block title %}Mon Profil | EduPulse{% endblock %}
{% block page_title %}Mon Profil{% endblock %}

{% block body %}
<div class="animate-fade-in max-w-2xl mx-auto">

    <div style="background:rgba(15,23,42,0.7);border:1px solid rgba(255,255,255,0.07);border-radius:24px;overflow:hidden;backdrop-filter:blur(20px)">

        {# Banner & Avatar #}
        <div style="height:140px;background:linear-gradient(135deg,rgba(99,102,241,0.5),rgba(6,182,212,0.5));position:relative">
            <div id="avatar-preview" style="position:absolute;bottom:-52px;left:32px;width:104px;height:104px;border-radius:50%;border:4px solid #0f172a;overflow:hidden;background:#1e293b;display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:800;color:#94a3b8;cursor:pointer" onclick="document.getElementById('photo-input-trigger').click()">
                {% if user.profilePhoto %}
                    <img id="avatar-img" src="{{ asset('uploads/profiles/' ~ user.profilePhoto) }}" alt="" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0" onerror="this.style.display='none'">
                {% else %}
                    <span id="avatar-initials">{{ user.firstName|first }}{{ user.lastName|first }}</span>
                {% endif %}
                <div style="position:absolute;inset:0;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.2s;font-size:20px" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0'">📷</div>
            </div>
        </div>

        {# Form #}
        {{ form_start(form, {attr: {enctype: 'multipart/form-data', style: 'padding:80px 32px 32px;display:flex;flex-direction:column;gap:20px'}}) }}
            <style>
                .edu-form-field label { display:block;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#64748b;margin-bottom:8px }
                .edu-form-field input, .edu-form-field select, .edu-form-field textarea {
                    width:100%;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:12px;
                    padding:12px 16px;color:#f1f5f9;font-size:14px;outline:none;transition:all 0.2s;box-sizing:border-box;font-family:inherit
                }
                .edu-form-field input:focus, .edu-form-field select:focus, .edu-form-field textarea:focus {
                    border-color:rgba(99,102,241,0.6);background:rgba(99,102,241,0.06);box-shadow:0 0 0 3px rgba(99,102,241,0.15)
                }
                /* Hide default file input & the form_row label for it */
                .edu-form-field.hidden-upload { display:none }
            </style>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                <div class="edu-form-field">{{ form_row(form.firstName) }}</div>
                <div class="edu-form-field">{{ form_row(form.lastName) }}</div>
            </div>
            <div class="edu-form-field">{{ form_row(form.phone) }}</div>
            <div class="edu-form-field">{{ form_row(form.bio) }}</div>

            {# Hidden file input triggered by clicking avatar #}
            <div class="edu-form-field hidden-upload">{{ form_row(form.profilePhotoFile, {attr: {id: 'photo-input-trigger'}}) }}</div>
            
            {# Photo preview hint #}
            <div style="font-size:12px;color:#475569;text-align:center;margin-top:-12px">📷 Cliquez sur votre photo pour la modifier</div>

            <button type="submit" style="width:100%;padding:14px;border-radius:14px;background:linear-gradient(135deg,#6366f1,#4f46e5);color:#fff;font-size:15px;font-weight:700;border:none;cursor:pointer;transition:opacity 0.2s;margin-top:8px" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
                💾 Enregistrer les modifications
            </button>
        {{ form_end(form) }}
    </div>

    <script>
        // Preview avatar before upload
        document.getElementById('photo-input-trigger').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(ev) {
                const preview = document.getElementById('avatar-preview');
                let img = document.getElementById('avatar-img');
                if (!img) {
                    img = document.createElement('img');
                    img.id = 'avatar-img';
                    img.style.cssText = 'width:100%;height:100%;object-fit:cover;position:absolute;inset:0;z-index:5';
                    preview.appendChild(img);
                    const initials = document.getElementById('avatar-initials');
                    if (initials) initials.style.display = 'none';
                }
                img.src = ev.target.result;
                img.style.display = 'block';
            };
            reader.readAsDataURL(file);
        });
    </script>
</div>
{% endblock %}
